---
import { ui, postCount, social, avatarSrc, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  count: number;
}
const { lang, count } = Astro.props;
const t = ui[lang];
---

<section class="profile">
  <img class="avatar" src={avatarSrc} width="84" height="84" alt="Jieun" loading="eager" />
  <h1 class="name">{t.siteTitle}</h1>
  <p class="bio">{t.tagline}</p>
  <p class="count">{postCount(lang, count)}</p>

  <nav class="socials" aria-label="Social links">
    <a href={social.github} target="_blank" rel="me noopener" aria-label="GitHub">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.39 1.24-3.23-.13-.3-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 3-.4c1.02 0 2.05.14 3 .4 2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.25 2.88.12 3.18.77.84 1.24 1.92 1.24 3.23 0 4.62-2.81 5.64-5.49 5.94.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"/></svg>
    </a>
    <a href={social.linkedin} target="_blank" rel="me noopener" aria-label="LinkedIn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.8 0 0 .78 0 1.75v20.5C0 23.2.8 24 1.77 24h20.45c.98 0 1.78-.8 1.78-1.75V1.75C24 .78 23.2 0 22.22 0Z"/></svg>
    </a>
    <a href={`mailto:${social.email}`} title={social.email} aria-label={`Email: ${social.email}`} data-copy-email>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
    </a>
  </nav>
  <!-- 메일 앱이 등록돼 있지 않으면 mailto: 는 아무 반응이 없다. 주소를 복사해 주고
       복사됐다는 사실을 눈에 보이게 알린다. (문구 대신 주소 자체를 띄워 다국어 회피) -->
  <p class="copied" data-copy-toast aria-live="polite"></p>
</section>

<style>
  .profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0;
    padding: 2.5rem 1.5rem;
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: var(--shadow-sm);
  }
  .avatar {
    width: 84px;
    height: 84px;
    border-radius: 999px;
    object-fit: cover;
    /* 테두리 대신 옅은 그림자 링 */
    box-shadow: 0 2px 10px rgba(24, 24, 27, 0.14);
  }
  .name {
    margin: 1rem 0 0;
    font-size: 1.5em;
    font-weight: 750;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--text);
  }
  .bio {
    margin: 0.5rem 0 0;
    max-width: 30rem;
    font-size: 0.92em;
    color: var(--text-muted);
    line-height: 1.5;
  }
  .count {
    margin: 0.35rem 0 0;
    font-size: 0.82em;
    font-weight: 500;
    color: var(--text-subtle);
  }
  .socials {
    display: flex;
    gap: 0.85rem;
    margin-top: 1.1rem;
  }
  .socials a {
    display: inline-flex;
    color: var(--text-subtle);
    transition: color 0.15s;
  }
  .socials a:hover { color: var(--text); }

  /* 복사 안내 — 자리를 항상 차지해 두어 나타날 때 레이아웃이 밀리지 않게 한다 */
  .copied {
    margin: 0.6rem 0 0;
    min-height: 1.1em;
    font-size: 0.78em;
    color: var(--accent);
    opacity: 0;
    transition: opacity 0.18s;
  }
  .copied.show { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .copied { transition: none; }
  }
</style>

<script is:inline>
  (() => {
    const link = document.querySelector('[data-copy-email]');
    const toast = document.querySelector('[data-copy-toast]');
    if (!link || !toast) return;
    let timer;

    // 복사 성공 여부와 무관하게 주소를 띄운다. 복사가 막힌 환경(권한 거부·구형 브라우저)
    // 에서도 최소한 주소를 눈으로 읽고 직접 긁어갈 수 있어야 한다.
    const show = (copied, addr) => {
      toast.textContent = (copied ? '✓ ' : '') + addr;
      toast.classList.add('show');
      clearTimeout(timer);
      timer = setTimeout(() => toast.classList.remove('show'), 2400);
    };

    link.addEventListener('click', () => {
      const addr = link.getAttribute('href').replace(/^mailto:/, '');
      // preventDefault 하지 않는다 — 메일 앱이 있는 사용자는 기존대로 작성창이 열리고,
      // 없는 사용자는 최소한 주소가 복사된 것을 확인할 수 있다.
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(addr).then(
          () => show(true, addr),
          () => show(false, addr)
        );
      } else {
        show(false, addr);
      }
    });
  })();
</script>
