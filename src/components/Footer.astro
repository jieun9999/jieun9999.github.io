---
import { ui, type Lang } from '../i18n/ui';
import SocialLinks from './SocialLinks.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

// GNB 와 같은 구성. GitHub·LinkedIn 은 아래 아이콘이 맡는다
const pages = [
  { href: `/${lang}/`, label: t.home },
  { href: `/${lang}/about/`, label: t.about },
  { href: `/${lang}/tags/`, label: t.tags },
];
---

<footer class="site-footer">
  <div class="frame">
    <hr class="divider" />
  </div>
  <div class="frame inner">
    <div class="top">
      <div class="brand-col">
        <a class="brand" href={`/${lang}/`}>
          <img src="/favicon-96x96.png" width="26" height="26" alt="" aria-hidden="true" />
          <span>{t.siteTitle}</span>
        </a>
        <p class="desc">{t.tagline}</p>
      </div>
      <div class="cols">
        <nav class="col" aria-label={t.pages}>
          <p class="eyebrow col-title">{t.pages}</p>
          {pages.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      </div>
    </div>

    <hr class="divider" />

    <div class="bottom">
      <p class="copy">© {new Date().getFullYear()} {t.siteTitle} — Built with <strong>Astro</strong></p>
      <SocialLinks />
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--bg); }
  .inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-block: 64px 36px;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
  }
  .brand-col {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 18px;
    font-weight: 800;
    color: var(--text);
  }
  .brand:hover { color: var(--text); }
  :global(html.dark) .brand img { filter: brightness(1.3) saturate(1.05); }
  .desc {
    max-width: 300px;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.5;
    color: var(--text);
  }
  .cols {
    display: flex;
    gap: 64px;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .col-title {
    margin-bottom: 6px;
    color: var(--text);
  }
  .col a {
    font-size: 15px;
    font-weight: 500;
    line-height: 1.5;
    color: var(--text-muted);
    transition: color 0.3s cubic-bezier(0.44, 0, 0.56, 1);
  }
  .col a:hover { color: var(--accent); }

  .bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .copy {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--text);
  }
  .copy strong { font-weight: 800; }

  @media (max-width: 809px) {
    .inner { gap: 16px; padding-block: 24px; }
    .top { flex-direction: column; gap: 30px; }
    .cols { gap: 30px; flex-wrap: wrap; }
    .bottom { flex-direction: column-reverse; align-items: flex-start; }
  }
</style>

