---
// 모든 페이지의 <head>에 들어가는 SEO 요소를 한 곳에서 관리.
import type { Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** 언어별 대체 URL(hreflang용). 실제로 존재하는 번역만 담는다. */
  alternates?: Partial<Record<Lang, string>>;
  /** og:type — 글이면 'article', 목록/홈이면 'website' */
  type?: 'website' | 'article';
  /** SNS 공유 이미지 (없으면 기본 브랜드 배너) */
  image?: string;
  /** 검색 대표 URL 오버라이드. 있으면 canonical을 이 주소로(예: 해쉬노드 원본). 없으면 self. */
  canonicalURL?: string;
}

const {
  title,
  description,
  lang,
  alternates = {},
  type = 'website',
  image,
  canonicalURL,
} = Astro.props;

const site = Astro.site ?? new URL('https://jieun.dev');
// 이 페이지 자신의 URL. og:url·RSS 등 "실제 위치"가 필요한 곳에 쓴다.
const selfUrl = new URL(Astro.url.pathname, site).href;
// 검색 대표(canonical): 오버라이드가 있으면 그쪽, 없으면 self.
const canonical = canonicalURL ?? selfUrl;
// 기본 배너. 브랜드가 바뀌면 파일명의 버전을 올린다 — 링크드인·카톡 등은 이미지를
// URL 단위로 캐시해서, 같은 경로에 덮어쓰면 예전 그림이 계속 나온다.
const ogImage = new URL(image ?? '/og-default-v3.jpg', site).href;

// hreflang 절대 URL 목록 (구글에게 "같은 글의 다른 언어 버전"임을 알림)
const hreflangs = Object.entries(alternates).map(([l, path]) => ({
  lang: l,
  href: new URL(path!, site).href,
}));

// x-default 는 "어느 언어에도 해당하지 않는 사용자를 여기로 보내라"는 단일 지정이라,
// 같은 hreflang 묶음에 속한 페이지들이 전부 같은 URL 을 가리켜야 한다.
//
// ⚠ 예전엔 hreflangs[0] 을 썼는데, 이건 alternates 객체의 키 순서를 그대로 따라간다.
//   그래서 ko 페이지는 ko 를, en 페이지는 en 을 x-default 로 지목했다. 서로 "내가
//   기본"이라고 주장하는 셈이라, Google 이 묶음 전체를 무시할 수 있다
//   (= ko↔en 짝 연결까지 같이 무효가 된다).
//
// 사이트 기본 언어(astro.config 의 defaultLocale = 'en', 루트 '/' 도 /en/ 으로 보낸다)로
// 고정하고, 영어판이 없는 글에서만 남은 것 중 첫 번째로 폴백한다.
const DEFAULT_LANG = 'en';
const xDefaultHref =
  hreflangs.find((h) => h.lang === DEFAULT_LANG)?.href ?? hreflangs[0]?.href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<!-- 값은 아래 인라인 스크립트가 실제 적용된 테마에 맞춰 덮어쓴다.
     (OS 설정이 아니라 KST 시각으로 테마가 정해지므로 prefers-color-scheme 을 쓸 수 없다) -->
<meta name="theme-color" content="#fafafa" />
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<!-- iOS 홈 화면에 추가했을 때 아이콘 밑에 붙는 이름 (기본값은 <title> 전체라 길다) -->
<meta name="apple-mobile-web-app-title" content="Jieun" />
<meta name="generator" content={Astro.generator} />

<!-- 기본 SEO -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<!-- 다국어 SEO: hreflang -->
{
  hreflangs.map(({ lang: l, href }) => (
    <link rel="alternate" hreflang={l} href={href} />
  ))
}
{
  xDefaultHref && (
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
  )
}

<!-- Open Graph (SNS 공유 미리보기) -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Jieun" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={selfUrl} />
<meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- RSS 자동발견 -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={title}
  href={new URL(`/${lang}/rss.xml`, site).href}
/>

<!-- 다크모드: 페이지가 그려지기 전에 테마를 결정해 '깜빡임' 방지.
     기본값은 한국 시각(KST) — 06~18시 라이트, 18~06시 다크.
     수동 토글은 '다음 자동 전환 시점까지'만 유지된다(아래 주석 참고). -->
<script is:inline>
  (() => {
    // OS 가 다크를 선호하면 시각과 무관하게 다크. (눈부심 때문에 항상 다크를 쓰는
    // 사용자를 낮이라고 라이트로 되돌리지 않는다.)
    // 그 외에는 한국 시각으로 정한다 — KST 는 서머타임이 없어 UTC+9 산술로 정확하고
    // Intl 타임존 DB 에 의존하지 않는다.
    const prefersDark =
      typeof window.matchMedia === 'function' &&
      window.matchMedia('(prefers-color-scheme: dark)').matches;
    const kstHour = (new Date().getUTCHours() + 9) % 24;
    const auto = prefersDark || kstHour < 6 || kstHour >= 18 ? 'dark' : 'light';

    // 수동 선택은 {mode, auto} 로 저장한다. 저장 당시의 auto 와 지금 auto 가 다르면
    // = 그 사이에 낮/밤이 바뀐 것이므로 수동 선택을 버리고 자동으로 돌아간다.
    // (안 그러면 한 번 토글한 사람에게 시간 기반 전환이 영원히 안 먹는다.)
    let mode = auto;
    try {
      const raw = localStorage.getItem('theme-override');
      if (raw) {
        const o = JSON.parse(raw);
        if (o && o.auto === auto && (o.mode === 'dark' || o.mode === 'light')) {
          mode = o.mode;
        } else {
          localStorage.removeItem('theme-override');
        }
      }
      localStorage.removeItem('theme'); // 구버전 키 정리
    } catch (_) {
      /* localStorage 차단(사생활 보호 모드 등) — 자동값으로 간다 */
    }

    window.__autoTheme = auto; // 토글이 저장할 때 쓴다
    document.documentElement.classList.toggle('dark', mode === 'dark');

    // 모바일 브라우저 주소창 색을 실제 테마에 맞춘다 (global.css 의 --bg 와 같은 값)
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', mode === 'dark' ? '#0d1310' : '#fafafa');
  })();
</script>
