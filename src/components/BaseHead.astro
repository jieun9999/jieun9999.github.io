---
// 모든 페이지의 <head>에 들어가는 SEO 요소를 한 곳에서 관리.
import type { Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** 언어별 대체 URL(hreflang용). 실제로 존재하는 번역만 담는다. */
  alternates?: Partial<Record<Lang, string>>;
  /** og:type — 글이면 'article', 목록/홈이면 'website' */
  type?: 'website' | 'article';
  /** SNS 공유 이미지 (없으면 기본 브랜드 배너) */
  image?: string;
  /** 검색 대표 URL 오버라이드. 있으면 canonical을 이 주소로(예: 해쉬노드 원본). 없으면 self. */
  canonicalURL?: string;
}

const {
  title,
  description,
  lang,
  alternates = {},
  type = 'website',
  image,
  canonicalURL,
} = Astro.props;

const site = Astro.site ?? new URL('https://jieun.dev');
// 이 페이지 자신의 URL. og:url·RSS 등 "실제 위치"가 필요한 곳에 쓴다.
const selfUrl = new URL(Astro.url.pathname, site).href;
// 검색 대표(canonical): 오버라이드가 있으면 그쪽, 없으면 self.
const canonical = canonicalURL ?? selfUrl;
const ogImage = new URL(image ?? '/og-default-v2.jpg', site).href;

// hreflang 절대 URL 목록 (구글에게 "같은 글의 다른 언어 버전"임을 알림)
const hreflangs = Object.entries(alternates).map(([l, path]) => ({
  lang: l,
  href: new URL(path!, site).href,
}));

// x-default 는 "어느 언어에도 해당하지 않는 사용자를 여기로 보내라"는 단일 지정이라,
// 같은 hreflang 묶음에 속한 페이지들이 전부 같은 URL 을 가리켜야 한다.
//
// ⚠ 예전엔 hreflangs[0] 을 썼는데, 이건 alternates 객체의 키 순서를 그대로 따라간다.
//   그래서 ko 페이지는 ko 를, en 페이지는 en 을 x-default 로 지목했다. 서로 "내가
//   기본"이라고 주장하는 셈이라, Google 이 묶음 전체를 무시할 수 있다
//   (= ko↔en 짝 연결까지 같이 무효가 된다).
//
// 사이트 기본 언어(astro.config 의 defaultLocale = 'en', 루트 '/' 도 /en/ 으로 보낸다)로
// 고정하고, 영어판이 없는 글에서만 남은 것 중 첫 번째로 폴백한다.
const DEFAULT_LANG = 'en';
const xDefaultHref =
  hreflangs.find((h) => h.lang === DEFAULT_LANG)?.href ?? hreflangs[0]?.href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0b0e14" media="(prefers-color-scheme: dark)" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- 기본 SEO -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<!-- 다국어 SEO: hreflang -->
{
  hreflangs.map(({ lang: l, href }) => (
    <link rel="alternate" hreflang={l} href={href} />
  ))
}
{
  xDefaultHref && (
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
  )
}

<!-- Open Graph (SNS 공유 미리보기) -->
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={selfUrl} />
<meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- RSS 자동발견 -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={title}
  href={new URL(`/${lang}/rss.xml`, site).href}
/>

<!-- 다크모드: 페이지가 그려지기 전에 테마를 결정해 '깜빡임' 방지 -->
<script is:inline>
  (() => {
    const saved = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    if (saved === 'dark' || (!saved && prefersDark)) {
      document.documentElement.classList.add('dark');
    }
  })();
</script>
