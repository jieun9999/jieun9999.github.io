---
// 모든 페이지의 <head>에 들어가는 SEO 요소를 한 곳에서 관리.
import type { Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** 언어별 대체 URL(hreflang용). 실제로 존재하는 번역만 담는다. */
  alternates?: Partial<Record<Lang, string>>;
  /** og:type — 글이면 'article', 목록/홈이면 'website' */
  type?: 'website' | 'article';
  /** SNS 공유 이미지 (없으면 기본 브랜드 배너) */
  image?: string;
  /** 검색 대표 URL 오버라이드. 있으면 canonical을 이 주소로(예: 해쉬노드 원본). 없으면 self. */
  canonicalURL?: string;
  /** true 면 robots noindex — 내용이 아직 없는 페이지용 */
  noindex?: boolean;
}

const {
  title,
  description,
  lang,
  alternates = {},
  type = 'website',
  image,
  canonicalURL,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://jieun.dev');
// 이 페이지 자신의 URL. og:url·RSS 등 "실제 위치"가 필요한 곳에 쓴다.
const selfUrl = new URL(Astro.url.pathname, site).href;
// 검색 대표(canonical): 오버라이드가 있으면 그쪽, 없으면 self.
const canonical = canonicalURL ?? selfUrl;
// 기본 배너. 브랜드가 바뀌면 파일명의 버전을 올린다 — 링크드인·카톡 등은 이미지를
// URL 단위로 캐시해서, 같은 경로에 덮어쓰면 예전 그림이 계속 나온다.
const ogImage = new URL(image ?? '/og-default-v7.jpg', site).href;

// hreflang 절대 URL 목록 (구글에게 "같은 글의 다른 언어 버전"임을 알림)
const hreflangs = Object.entries(alternates).map(([l, path]) => ({
  lang: l,
  href: new URL(path!, site).href,
}));

// x-default 는 "어느 언어에도 해당하지 않는 사용자를 여기로 보내라"는 단일 지정이라,
// 같은 hreflang 묶음에 속한 페이지들이 전부 같은 URL 을 가리켜야 한다.
//
// ⚠ 예전엔 hreflangs[0] 을 썼는데, 이건 alternates 객체의 키 순서를 그대로 따라간다.
//   그래서 ko 페이지는 ko 를, en 페이지는 en 을 x-default 로 지목했다. 서로 "내가
//   기본"이라고 주장하는 셈이라, Google 이 묶음 전체를 무시할 수 있다
//   (= ko↔en 짝 연결까지 같이 무효가 된다).
//
// 사이트 기본 언어(astro.config 의 defaultLocale = 'en', sitemap 의 defaultLocale 도 en)로
// 고정하고, 영어판이 없는 글에서만 남은 것 중 첫 번째로 폴백한다.
//
// 루트 '/' 는 사람을 /ko/ 로 보내지만(주 독자가 한국어), x-default 는 그걸 따라가지 않는다.
// x-default 는 "한국어도 영어도 아닌 검색 사용자"를 어디로 보낼지라 영어판이 맞다.
const DEFAULT_LANG = 'en';
const xDefaultHref =
  hreflangs.find((h) => h.lang === DEFAULT_LANG)?.href ?? hreflangs[0]?.href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#ffffff" />
<meta name="color-scheme" content="light" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<!-- iOS 홈 화면에 추가했을 때 아이콘 밑에 붙는 이름 (기본값은 <title> 전체라 길다) -->
<meta name="apple-mobile-web-app-title" content="Jieun" />
<meta name="generator" content={Astro.generator} />

<!-- 기본 SEO -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}

<!-- 다국어 SEO: hreflang -->
{
  hreflangs.map(({ lang: l, href }) => (
    <link rel="alternate" hreflang={l} href={href} />
  ))
}
{
  xDefaultHref && (
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
  )
}

<!-- Open Graph (SNS 공유 미리보기) -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Jieun" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={selfUrl} />
<meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- RSS 자동발견 -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={title}
  href={new URL(`/${lang}/rss.xml`, site).href}
/>

<!-- 흰 배경 고정. 첫 화면 모션과 더 보기의 JS 표시를 초기화한다. -->
<script is:inline>
  (() => {
    // JS 가 도는 환경 표시 — "더 보기"처럼 스크립트가 있어야 의미 있는 숨김에만 쓴다
    document.documentElement.classList.add('js');

    // 첫 화면 모션(GSAP)이 뜨기 전에 첫 화면을 숨겨 둔다 — 그 페이지 스크립트가 떼면서 띄운다(src/lib/motion.ts).
    // 모션을 줄인 사용자는 건너뛰고, 스크립트가 끝내 못 뜨면 2.5초 뒤 그냥 보여준다.
    if (!(typeof window.matchMedia === 'function' && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) {
      document.documentElement.classList.add('gsap-enter');
      setTimeout(() => document.documentElement.classList.remove('gsap-enter'), 2500);
    }
  })();
</script>
