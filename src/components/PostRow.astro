---
// 글 한 줄 — 왼쪽 큰 이미지 + 오른쪽 [카테고리 … 날짜] → 제목 → 최대 두 줄 부제 → 태그.
// 대표 글과 목록이 같은 모양을 쓴다. 좁은 화면에선 이미지가 위로 올라간다.
// 글쓴이는 한 명이라 목록에선 프로필을 빼고, 눈이 제목·부제로 가게 나머지는 옅게 둔다.
import { categoryLabel, type Lang } from '../i18n/ui';
import { postUrl, categoryUrl, tagUrl, type Post } from '../lib/posts';

interface Props {
  lang: Lang;
  post: Post;
  /** 대표 글은 h2, 목록은 h3 */
  headingLevel?: 'h2' | 'h3';
  /** 첫 화면에 보이는 이미지는 바로 받는다 */
  eager?: boolean;
}
const { lang, post, headingLevel = 'h3', eager = false } = Astro.props;
const { title, subtitle, description, pubDate, category, tags, cover, coverAlt } = post.data;
// 부제가 없으면 요약을 대신 쓴다. 어느 쪽이든 최대 두 줄까지 표시한다
const lead = subtitle ?? description;
// 태그는 앞에서 세 개만 — 대표 태그를 앞에 적는다
const shownTags = tags.slice(0, 3);
const isoDate = pubDate.toISOString().slice(0, 10);
const href = postUrl(lang, post);
const Heading = headingLevel;
const monogram = (title.trim()[0] ?? '·').toUpperCase();
---

<div class="row">
  <a class="img" href={href} tabindex="-1" aria-hidden="true">
    {
      cover ? (
        <img
          src={cover}
          alt={coverAlt ?? title}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <span class="mono">{monogram}</span>
      )
    }
  </a>
  <div class="content">
    <div class="top">
      <a class="cat" href={categoryUrl(lang, category)}>{categoryLabel(category)}</a>
      <time datetime={isoDate}>{isoDate}</time>
    </div>
    <Heading class="title"><a href={href}>{title}</a></Heading>
    <p class="lead"><a href={href} tabindex="-1">{lead}</a></p>
    {
      shownTags.length > 0 && (
        <ul class="tags">
          {shownTags.map((t) => (
            <li>
              <a class="tag" href={tagUrl(lang, t)}>#{t}</a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</div>

<style>
  /* 글 칸을 이미지 높이만큼 늘린다 — 윗줄은 이미지 윗선, 태그는 이미지 아랫선에 붙어 줄마다 같은 자리에 온다 */
  .row {
    display: flex;
    align-items: stretch;
    gap: 40px;
  }
  .img {
    flex: 0 0 45%;
    min-width: 0;
    position: relative;
    aspect-ratio: 16 / 9; /* 커버 대부분이 16:9 — 이 비율이면 잘리지 않는다 */
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
  }
  /* 선을 이미지 위에 얹어야 흰 바탕 다이어그램도 가장자리가 보인다 */
  .img::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid var(--border);
    border-radius: inherit;
    pointer-events: none;
  }
  .img img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .img:hover img { transform: scale(1.03); }
  .mono {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-size: 48px;
    font-weight: 800;
    color: var(--accent);
  }
  .content {
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding-block: 4px;
  }
  /* 카테고리 왼쪽, 날짜 오른쪽 — 둘 다 옅게 */
  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
  }
  .cat {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-subtle);
    transition: color 0.15s;
  }
  .cat:hover { color: var(--text); }
  .top time { color: var(--text-faint); font-variant-numeric: tabular-nums; }
  .title {
    margin: 16px 0 0;
    font-size: 22px;
    font-weight: 800;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .title a { color: var(--text); transition: color 0.2s; }
  .title a:hover { color: var(--accent); }
  .lead {
    margin-top: 8px;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.55;
    color: var(--text-muted);
    /* 최대 두 줄까지 표시하고 넘치는 내용은 말줄임표로 처리한다 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .lead a { color: inherit; }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: auto 0 0;
    padding: 20px 0 0;
    list-style: none;
  }

  @media (max-width: 1071px) {
    .row { flex-direction: column; align-items: stretch; gap: 24px; }
    .img { flex: none; width: 100%; }
    .content { padding-block: 0; }
  }
  @media (max-width: 809px) {
    .row { gap: 14px; }
    .title { margin-top: 10px; font-size: 20px; }
    .lead { margin-top: 6px; font-size: 15px; }
    .tags { padding-top: 14px; }
  }
</style>
