---
// 떠다니는 에버그린 점(파티클) — 사이트의 바탕 표정. 히어로(Hero)와 소개 카드 뒤에 깐다.
// 부모를 꽉 채우므로(position: absolute; inset: 0) 넣는 쪽이 position: relative + overflow: hidden 을 준다.
interface Props {
  /** 점 개수 상한. 밀도(면적/7000)는 같고, 히어로 띠보다 훨씬 넓은 곳(소개 페이지 전체)에서 올린다 */
  max?: number;
}
const { max = 90 } = Astro.props;
---

<canvas class="particles" data-particles data-max={max} aria-hidden="true"></canvas>

<style>
  .particles {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    /* 점 색 — 에버그린 6단계에서 점마다 하나씩 무작위로 고른다(스크립트가 읽는다).
       라이트는 흰 바탕에 맞춘 진한 쪽, 다크는 검은 바탕에 맞춘 밝은 쪽. 배경은 그대로 무채색. */
    --dot-1: #195e3f;
    --dot-2: #256648;
    --dot-3: #307252;
    --dot-4: #3d8160;
    --dot-5: #4b916e;
    --dot-6: #a9e0c1;
  }
  :global(html.dark) .particles {
    --dot-1: #3e8562;
    --dot-2: #4f9773;
    --dot-3: #5da781;
    --dot-4: #72be96;
    --dot-5: #8fd4ad;
    --dot-6: #bcebd1;
  }
</style>

<script>
  // 가벼운 캔버스 파티클 — 작은 점이 천천히 떠다닌다.
  // 화면 밖이면 멈추고, 움직임 줄이기 설정이면 한 번만 그린다.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLCanvasElement>('canvas[data-particles]').forEach((canvas) => {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    type Dot = { x: number; y: number; r: number; vx: number; vy: number; a: number; c: number };
    let dots: Dot[] = [];
    let palette: string[] = [];
    let w = 0;
    let h = 0;
    let raf = 0;
    let visible = true;

    // 테마마다 CSS 가 --dot-1..6 을 바꿔 끼운다. 매 프레임 읽지 않고 테마가 바뀔 때만 다시 읽는다.
    const readPalette = () => {
      const cs = getComputedStyle(canvas);
      palette = [1, 2, 3, 4, 5, 6].map((i) => cs.getPropertyValue(`--dot-${i}`).trim());
    };

    const seed = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.min(Number(canvas.dataset.max) || 90, Math.round((w * h) / 7000));
      dots = Array.from({ length: n }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: 0.5 + Math.random() * 1.2, // 무채색일 때(0.4–1.3)보다 살짝 크게 — 너무 작으면 색이 안 읽힌다
        vx: (Math.random() - 0.5) * 0.12,
        vy: (Math.random() - 0.5) * 0.12,
        a: 0.25 + Math.random() * 0.6,
        c: Math.floor(Math.random() * 6),
      }));
    };

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      for (const d of dots) {
        ctx.fillStyle = palette[d.c];
        ctx.globalAlpha = d.a;
        ctx.beginPath();
        ctx.arc(d.x, d.y, d.r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    };

    const step = () => {
      for (const d of dots) {
        d.x += d.vx;
        d.y += d.vy;
        if (d.x < -2) d.x = w + 2;
        if (d.x > w + 2) d.x = -2;
        if (d.y < -2) d.y = h + 2;
        if (d.y > h + 2) d.y = -2;
      }
      draw();
      raf = visible ? requestAnimationFrame(step) : 0;
    };

    const start = () => {
      if (reduce) return draw();
      if (!raf) raf = requestAnimationFrame(step);
    };

    readPalette();
    seed();
    start();
    new ResizeObserver(() => {
      seed();
      draw();
    }).observe(canvas);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) start();
    }).observe(canvas);
    // 테마가 바뀌면 팔레트를 다시 읽는다 (움직임을 끈 경우 다시 그려야 한다)
    new MutationObserver(() => {
      readPalette();
      draw();
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });
  });
</script>
