---
// 작성자 · 날짜 한 줄. 템플릿처럼 둘 사이를 기울어진 가는 선으로 나눈다.
import { ui, avatarSrc, formatDate, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  date: Date;
  /** 읽는 시간(분). 있으면 날짜 뒤에 붙인다 */
  mins?: number;
  /** 수정일. 있으면 맨 뒤에 붙인다 */
  updated?: Date;
}
const { lang, date, mins, updated } = Astro.props;
const t = ui[lang];
---

<div class="meta">
  <span class="author">
    <img src={avatarSrc} width="20" height="20" alt="" aria-hidden="true" loading="lazy" />
    <span>{t.siteTitle}</span>
  </span>
  <span class="slash" aria-hidden="true"></span>
  <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
  {
    mins && (
      <>
        <span class="dot" aria-hidden="true">·</span>
        <span>
          {mins} {t.minRead}
        </span>
      </>
    )
  }
  {
    updated && (
      <>
        <span class="dot" aria-hidden="true">·</span>
        <span>
          {t.updatedOn} <time datetime={updated.toISOString()}>{formatDate(updated, lang)}</time>
        </span>
      </>
    )
  }
</div>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text-muted);
  }
  .author {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .author img {
    width: 20px;
    height: 20px;
    border-radius: 999px;
    object-fit: cover;
    border: 1px solid var(--hairline);
  }
  .slash {
    width: 1px;
    height: 14px;
    margin-inline: 5px;
    border-radius: 6px;
    background: var(--border-strong);
    transform: rotate(24deg);
  }
  .dot { color: var(--text-faint); }
</style>
