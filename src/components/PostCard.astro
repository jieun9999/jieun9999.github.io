---
import { ui, formatDate, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
  mins: number;
  cover?: string;
  coverAlt?: string;
}
const { lang, slug, title, description, pubDate, mins, cover, coverAlt } = Astro.props;
const t = ui[lang];

// 커버 없을 때: 뉴트럴 타일 + 제목 첫 글자 모노그램 (색 없음)
const monogram = (title.trim()[0] ?? '·').toUpperCase();
const href = `/${lang}/blog/${slug}/`;
---

<li class="pc-item">
  <a class="pc" href={href}>
    <div class="pc-body">
      <h3 class="pc-title">{title}</h3>
      <p class="pc-desc">{description}</p>
      <div class="pc-meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
        <span class="dot">·</span>
        <span>{mins} {t.minRead}</span>
      </div>
    </div>

    <div class="pc-thumb">
      {
        cover ? (
          <img src={cover} alt={coverAlt ?? title} loading="lazy" decoding="async" />
        ) : (
          <span class="pc-tile" aria-hidden="true">
            <span class="pc-mono">{monogram}</span>
          </span>
        )
      }
    </div>
  </a>
</li>

<style>
  .pc-item { list-style: none; }
  .pc {
    display: flex;
    gap: 1.75rem;
    align-items: stretch;
    padding: 1.6rem 1.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: inherit;
    transition: border-color 0.18s, box-shadow 0.18s;
  }
  .pc:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
    color: inherit;
  }

  /* 왼쪽: 텍스트 */
  .pc-body {
    flex: 1 1 auto;
    min-width: 0; /* clamp/ellipsis 동작에 필수 */
    display: flex;
    flex-direction: column;
  }
  .pc-title {
    margin: 0;
    font-size: 1.4em;
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--text);
    text-wrap: balance;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    overflow-wrap: anywhere;
    transition: color 0.15s;
  }
  .pc:hover .pc-title { color: var(--accent); }
  .pc-desc {
    margin: 0.55rem 0 0;
    color: var(--text-muted);
    font-size: 0.98em;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .pc-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1rem;
    font-size: 0.85em;
    color: var(--text-subtle);
  }
  .pc-meta .dot { color: var(--text-subtle); }

  /* 오른쪽: 썸네일 / 뉴트럴 타일 */
  .pc-thumb {
    flex: 0 0 36%;
    max-width: 15rem;
    align-self: center;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface-2);
  }
  .pc-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .pc:hover .pc-thumb img { transform: scale(1.03); }
  .pc-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--surface-2), var(--surface));
  }
  .pc-mono {
    font-size: 2.6rem;
    font-weight: 800;
    color: var(--text-subtle);
    opacity: 0.55;
    letter-spacing: -0.02em;
  }

  /* 모바일: 세로 스택, 썸네일 위로 */
  @media (max-width: 34rem) {
    .pc { flex-direction: column; gap: 1.1rem; padding: 1.35rem; }
    .pc-thumb { flex: none; width: 100%; max-width: none; order: -1; }
  }
</style>
