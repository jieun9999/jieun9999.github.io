---
// 한/영 전환. 지금 언어가 아닌 쪽의 대응 URL 로 보내는 버튼 하나.
import { ui, otherLang, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** 각 언어의 현재 페이지 대응 URL */
  alternates: Record<Lang, string>;
  /** 모바일 메뉴 안에서는 글자 링크로 */
  variant?: 'icon' | 'text';
}
const { lang, alternates, variant = 'icon' } = Astro.props;
const other = otherLang(lang);
const label = ui[lang].switchLang;
---

{
  variant === 'icon' ? (
    <a class="icon-btn lang-btn" href={alternates[other]} hreflang={other} aria-label={label} title={label}>
      {other.toUpperCase()}
    </a>
  ) : (
    <a class="lang-text" href={alternates[other]} hreflang={other}>
      {label}
    </a>
  )
}

<style>
  .lang-btn {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
  }
</style>
