---
// 라이트/다크 전환 버튼. 상태는 localStorage에 저장.
---

<button id="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle theme">
  <svg class="sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
  <svg class="moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
</button>

<style>
  #theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.15rem;
    height: 2.15rem;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-muted);
    cursor: pointer;
    transition: color 0.15s, background 0.15s;
  }
  #theme-toggle:hover {
    color: var(--accent);
    background: var(--surface-2);
  }
  /* 라이트 모드에서는 달, 다크 모드에서는 해를 보여줌 */
  #theme-toggle .sun { display: none; }
  #theme-toggle .moon { display: block; }
  :global(html.dark) #theme-toggle .sun { display: block; }
  :global(html.dark) #theme-toggle .moon { display: none; }
</style>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', isDark ? '#0d1310' : '#fafafa');
    // 지금 시각의 자동값을 함께 남긴다. 낮/밤이 바뀌면 BaseHead 가 이 값을 버리고
    // 자동 모드로 되돌린다.
    try {
      localStorage.setItem(
        'theme-override',
        JSON.stringify({ mode: isDark ? 'dark' : 'light', auto: window.__autoTheme })
      );
    } catch (_) {
      /* localStorage 차단 — 이번 페이지에서만 적용되고 끝난다 */
    }
  });
</script>
