---
// GitHub · LinkedIn · 이메일 아이콘 링크 (홈 히어로·푸터·글 사이드바 공용).
// 아이콘은 예전 홈 프로필 카드에서 쓰던 것 그대로.
import { social } from '../i18n/ui';

interface Props {
  /** 이메일 복사 안내가 뜨는 쪽 — end: 아이콘 위 오른쪽 끝, start: 아래 왼쪽 끝, center: 아래 가운데 */
  toast?: 'start' | 'end' | 'center';
  /** 회색 아이콘 (히어로처럼 주변보다 한 톤 낮출 때) */
  muted?: boolean;
}
const { toast = 'end', muted = false } = Astro.props;
---

<div class:list={['socials', `toast-${toast}`, { muted }]} data-copy-scope>
  <p class="copied" data-copy-toast aria-live="polite"></p>
  <a href={social.github} target="_blank" rel="me noopener" aria-label="GitHub">
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.31 3.5 1 .11-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.39 1.24-3.23-.13-.3-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 3-.4c1.02 0 2.05.14 3 .4 2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.25 2.88.12 3.18.77.84 1.24 1.92 1.24 3.23 0 4.62-2.81 5.64-5.49 5.94.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12 12 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z"/></svg>
  </a>
  <a href={social.linkedin} target="_blank" rel="me noopener" aria-label="LinkedIn">
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.8 0 0 .78 0 1.75v20.5C0 23.2.8 24 1.77 24h20.45c.98 0 1.78-.8 1.78-1.75V1.75C24 .78 23.2 0 22.22 0Z"/></svg>
  </a>
  <a href={`mailto:${social.email}`} title={social.email} aria-label={`Email: ${social.email}`} data-copy-email>
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
  </a>
</div>

<style>
  .socials {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 999px;
    color: var(--text);
    transition: background 0.15s, color 0.15s;
  }
  .socials a:hover { background: var(--surface); color: var(--text); }
  .muted a { color: var(--text-faint); }
  .muted a:hover { background: transparent; color: var(--text); }

  /* 메일 앱이 등록돼 있지 않으면 mailto: 는 아무 반응이 없다. 주소를 복사해 주고
     복사됐다는 사실을 눈에 보이게 알린다. (문구 대신 주소 자체를 띄워 다국어 회피) */
  .copied {
    position: absolute;
    white-space: nowrap;
    font-size: 13px;
    font-weight: 700;
    color: var(--accent);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s;
  }
  .copied.show { opacity: 1; }
  .toast-end .copied { right: 0; bottom: calc(100% + 6px); }
  .toast-start .copied { left: 0; top: calc(100% + 6px); }
  .toast-center .copied { left: 50%; top: calc(100% + 6px); transform: translateX(-50%); }
  /* 좁은 화면에선 푸터가 세로로 쌓여 아이콘이 왼쪽 끝에 온다 — 안내도 왼쪽에서 펼친다 */
  @media (max-width: 809px) {
    .toast-end .copied { right: auto; left: 0; }
  }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-copy-email]').forEach((link) => {
    const toast = link.closest('[data-copy-scope]')?.querySelector<HTMLElement>('[data-copy-toast]');
    if (!toast) return;
    let timer: ReturnType<typeof setTimeout>;
    // 복사 성공 여부와 무관하게 주소를 띄운다. 복사가 막힌 환경(권한 거부·구형 브라우저)
    // 에서도 최소한 주소를 눈으로 읽고 직접 긁어갈 수 있어야 한다.
    const show = (copied: boolean, addr: string) => {
      toast.textContent = (copied ? '✓ ' : '') + addr;
      toast.classList.add('show');
      clearTimeout(timer);
      timer = setTimeout(() => toast.classList.remove('show'), 2400);
    };
    link.addEventListener('click', () => {
      const addr = link.getAttribute('href')!.replace(/^mailto:/, '');
      // preventDefault 하지 않는다 — 메일 앱이 있는 사용자는 기존대로 작성창이 열리고,
      // 없는 사용자는 최소한 주소가 복사된 것을 확인할 수 있다.
      if (navigator.clipboard?.writeText) {
        navigator.clipboard.writeText(addr).then(
          () => show(true, addr),
          () => show(false, addr)
        );
      } else {
        show(false, addr);
      }
    });
  });
</script>
