---
import { ui, type Lang } from '../i18n/ui';
import LanguageToggle from './LanguageToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import SearchDialog from './SearchDialog.astro';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
}
const { lang, alternates } = Astro.props;
const t = ui[lang];

const path = Astro.url.pathname;
const menu = [
  // 홈이 곧 글 목록이다 — 카테고리별 목록과 글 상세도 홈 아래로 친다
  {
    href: `/${lang}/`,
    label: t.home,
    current:
      path === `/${lang}/` ||
      path.startsWith(`/${lang}/category/`) ||
      path.startsWith(`/${lang}/blog/`),
  },
  { href: `/${lang}/about/`, label: t.about, current: path.startsWith(`/${lang}/about/`) },
  {
    href: `/${lang}/tags/`,
    label: t.tags,
    current: path.startsWith(`/${lang}/tags/`) || path.startsWith(`/${lang}/tag/`),
  },
];
---

<header class="site-header" data-header>
  <div class="frame bar">
    <a class="brand" href={`/${lang}/`} aria-label={`${t.siteTitle} — ${t.home}`}>
      <img src="/favicon-96x96.png" width="30" height="30" alt="" aria-hidden="true" />
      <span>{t.siteTitle}</span>
    </a>

    <nav class="menu" aria-label="Main">
      {
        menu.map((m) => (
          <a href={m.href} aria-current={m.current ? 'page' : undefined}>
            {m.label}
          </a>
        ))
      }
    </nav>

    <div class="tools">
      <button class="icon-btn" type="button" aria-label={t.search} title={t.search} data-search-open>
        <svg width="15" height="15" viewBox="0 0 256 256" aria-hidden="true"><path fill="currentColor" d="M232.49,215.51,185,168a92.12,92.12,0,1,0-17,17l47.53,47.54a12,12,0,0,0,17-17ZM44,112a68,68,0,1,1,68,68A68.07,68.07,0,0,1,44,112Z"/></svg>
      </button>
      <span class="lang-slot"><LanguageToggle lang={lang} alternates={alternates} /></span>
      <ThemeToggle label={t.toggleTheme} />
      <button
        class="icon-btn burger mobile-only"
        type="button"
        aria-label={t.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-label-open={t.openMenu}
        data-label-close={t.closeMenu}
        data-menu-toggle
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-panel" id="mobile-menu" hidden>
    <nav class="frame panel-links" aria-label="Main">
      {
        menu.map((m) => (
          <a href={m.href} aria-current={m.current ? 'page' : undefined}>
            {m.label}
          </a>
        ))
      }
      <hr class="divider" />
      <LanguageToggle lang={lang} alternates={alternates} variant="text" />
    </nav>
  </div>
</header>

<SearchDialog lang={lang} />

<style>
  .site-header {
    position: relative;
    z-index: 50;
    background: var(--bg);
  }
  /* 템플릿처럼 데스크톱에선 흘려보내고, 태블릿·모바일에선 위에 붙인다 */
  @media (max-width: 1199px) {
    .site-header { position: sticky; top: 0; }
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 80px;
  }
  .brand {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .brand:hover { color: var(--text); }
  .brand img { display: block; }
  /* 로고 원본이 짙은 초록·갈색이라 다크 배경에서 뭉개진다. 살짝 들어올린다. */
  :global(html.dark) .brand img { filter: brightness(1.3) saturate(1.05); }

  .menu {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .menu a,
  .panel-links a {
    padding: 2px;
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    transition: color 0.3s cubic-bezier(0.44, 0, 0.56, 1);
  }
  .menu a:hover,
  .menu a[aria-current='page'],
  .panel-links a:hover,
  .panel-links a[aria-current='page'] {
    color: var(--accent);
  }

  .tools {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .lang-slot { display: contents; }

  /* 원형 아이콘 버튼 (검색·테마·언어 공용) */
  .tools :global(.icon-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface-2) 70%, transparent);
    color: var(--text);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .tools :global(.icon-btn:hover) {
    background: var(--surface-2);
    color: var(--text);
  }

  /* 햄버거 — 세 줄이 X 로 접힌다 */
  .burger { position: relative; }
  .burger span {
    position: absolute;
    left: calc(50% - 7px);
    width: 14px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .burger span:nth-child(1) { top: 10px; }
  .burger span:nth-child(2) { top: calc(50% - 1px); }
  .burger span:nth-child(3) { bottom: 10px; }
  .burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(5px) rotate(45deg); }
  .burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-5px) rotate(-45deg); }

  /* .tools .icon-btn 보다 구체적이어야 데스크톱에서 햄버거가 숨는다 */
  .tools .mobile-only { display: none; }
  .mobile-panel { display: none; }

  @media (max-width: 809px) {
    .bar {
      grid-template-columns: 1fr auto;
      height: 60px;
    }
    .menu { display: none; }
    .tools { gap: 8px; }
    .lang-slot { display: none; }
    .tools .mobile-only { display: inline-flex; }

    .mobile-panel:not([hidden]) {
      display: block;
      position: fixed;
      inset: 60px 0 0;
      overflow-y: auto;
      background: var(--bg);
    }
    .panel-links {
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding-block: 16px 32px;
    }
    .panel-links a { padding: 8px 0; }
    .panel-links .divider { margin: 8px 0; }
    .panel-links :global(.lang-text) {
      padding: 8px 0;
      font-size: 16px;
      font-weight: 600;
      color: var(--text);
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.getElementById('mobile-menu');
  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '');
      document.body.style.overflow = open ? 'hidden' : '';
    };
    toggle.addEventListener('click', () => setOpen(panel.hidden));
    panel.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
    // 메뉴를 연 채로 창을 넓히면 패널이 숨겨져도 스크롤 잠금이 남는다
    matchMedia('(min-width: 810px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
