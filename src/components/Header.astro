---
import { ui, type Lang } from '../i18n/ui';
import LanguageToggle from './LanguageToggle.astro';
import ThemeToggle from './ThemeToggle.astro';
import SearchDialog from './SearchDialog.astro';
import BrandWordmark from './BrandWordmark.astro';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
}
const { lang, alternates } = Astro.props;
const t = ui[lang];

const path = Astro.url.pathname;
const menu = [
  // 홈이 곧 글 목록이다 — 카테고리별 목록과 글 상세도 홈 아래로 친다
  {
    href: `/${lang}/`,
    label: t.home,
    current:
      path === `/${lang}/` ||
      path.startsWith(`/${lang}/category/`) ||
      path.startsWith(`/${lang}/blog/`),
  },
  { href: `/${lang}/about/`, label: t.about, current: path.startsWith(`/${lang}/about/`) },
  {
    href: `/${lang}/tags/`,
    label: t.tags,
    current: path.startsWith(`/${lang}/tags/`) || path.startsWith(`/${lang}/tag/`),
  },
];
---

<header class="site-header" data-header>
  <div class="frame bar">
    <!-- 메뉴가 왼쪽에 서므로, 모바일에서 메뉴를 대신하는 햄버거도 왼쪽에 둔다 -->
    <div class="start">
      <button
        class="icon-btn burger mobile-only"
        type="button"
        aria-label={t.openMenu}
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-label-open={t.openMenu}
        data-label-close={t.closeMenu}
        data-menu-toggle
      >
        <span></span><span></span><span></span>
      </button>
      <nav class="menu" aria-label="Main">
        {
          menu.map((m) => (
            <a href={m.href} aria-current={m.current ? 'page' : undefined}>
              {m.label}
            </a>
          ))
        }
      </nav>
    </div>

    <a class="brand" href={`/${lang}/`} aria-label={`${t.siteTitle} — ${t.home}`}>
      <BrandWordmark id="brand-grad-header" />
    </a>

    <div class="tools">
      <button class="icon-btn" type="button" aria-label={t.search} title={t.search} data-search-open>
        <svg width="15" height="15" viewBox="0 0 256 256" aria-hidden="true"><path fill="currentColor" d="M232.49,215.51,185,168a92.12,92.12,0,1,0-17,17l47.53,47.54a12,12,0,0,0,17-17ZM44,112a68,68,0,1,1,68,68A68.07,68.07,0,0,1,44,112Z"/></svg>
      </button>
      <span class="lang-slot"><LanguageToggle lang={lang} alternates={alternates} /></span>
      <ThemeToggle label={t.toggleTheme} />
    </div>
  </div>

  <div class="mobile-panel" id="mobile-menu" hidden>
    <nav class="frame panel-links" aria-label="Main">
      {
        menu.map((m) => (
          <a href={m.href} aria-current={m.current ? 'page' : undefined}>
            {m.label}
          </a>
        ))
      }
      <hr class="divider" />
      <LanguageToggle lang={lang} alternates={alternates} variant="text" />
    </nav>
  </div>
</header>

<SearchDialog lang={lang} />

<style>
  .site-header {
    position: relative;
    z-index: 50;
    background: var(--bg);
    transition: background-color 0.2s ease;
  }
  /* 템플릿처럼 데스크톱에선 흘려보내고, 태블릿·모바일에선 위에 붙인다 */
  @media (max-width: 1071px) {
    .site-header { position: sticky; top: 0; }
  }
  /* 홈·카테고리·태그는 히어로가, 소개는 점 바탕이 헤더 뒤까지 올라온다(Hero snug) — 헤더를 비워 점이 로고 뒤에서도 떠다니게.
     위에 붙는 폭에선 스크롤하거나 메뉴를 열면 뒤가 비치지 않게 다시 칠한다. */
  :global(body:has([data-under-header])) .site-header { background: transparent; }
  @media (max-width: 1071px) {
    :global(body:has([data-under-header])) .site-header:is([data-solid], :has(.mobile-panel:not([hidden]))) {
      background: var(--bg);
    }
  }
  /* 비워둔 헤더 줄에 홈 사진 윗부분이 걸친다 — 빈 곳을 누르면 사진이 눌리게 헤더는 메뉴·로고·도구만 받는다 */
  :global(body:has([data-under-header])) .site-header:not([data-solid]) { pointer-events: none; }
  :global(body:has([data-under-header])) .site-header :is(.start, .brand, .tools, .mobile-panel) {
    pointer-events: auto;
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--header-h);
  }
  .start {
    justify-self: start;
    display: flex;
    align-items: center;
  }
  /* 양옆이 1fr 로 같은 폭이라 로고가 화면 정가운데에 선다 */
  .brand {
    justify-self: center;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    /* 심볼 없이 워드마크 하나로 서므로 글자를 키운다 */
    font-size: 36px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .brand:hover { color: var(--text); }
  /* 홈·카테고리는 히어로의 큰 이름이 로고 노릇을 한다(ProfileHero) — 헤더 로고는 숨겨 두고,
     위에 붙는 폭에서 이름이 헤더 밑으로 사라지면(data-brand-shown) 그때 꺼낸다 */
  .brand { transition: opacity 0.2s ease, visibility 0.2s ease; }
  :global(body:has([data-hero-name])) .site-header:not([data-brand-shown]) .brand {
    opacity: 0;
    visibility: hidden;
  }

  .menu {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .menu a,
  .panel-links a {
    padding: 2px;
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    transition: color 0.3s cubic-bezier(0.44, 0, 0.56, 1);
  }
  .menu a:hover,
  .menu a[aria-current='page'],
  .panel-links a:hover,
  .panel-links a[aria-current='page'] {
    color: var(--accent);
  }
  /* 현재 메뉴는 초록 밑줄로 표시한다 — 글자색만으론 검정과 잘 구분되지 않는다.
     마우스를 올리면 같은 밑줄이 가운데서 펼쳐진다. */
  .menu a,
  .panel-links a { position: relative; }
  .menu a::after,
  .panel-links a::after {
    content: '';
    position: absolute;
    left: 2px;
    right: 2px;
    bottom: -6px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transition: transform 0.25s cubic-bezier(0.44, 0, 0.56, 1);
  }
  .menu a:hover::after,
  .menu a[aria-current='page']::after,
  .panel-links a:hover::after,
  .panel-links a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .tools {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .lang-slot { display: contents; }

  /* 원형 아이콘 버튼 (검색·테마·언어·햄버거 공용) */
  .bar :global(.icon-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface-2) 70%, transparent);
    color: var(--text);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .bar :global(.icon-btn:hover) {
    background: var(--surface-2);
    color: var(--text);
  }

  /* 햄버거 — 세 줄이 X 로 접힌다 */
  .burger { position: relative; }
  .burger span {
    position: absolute;
    left: calc(50% - 7px);
    width: 14px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .burger span:nth-child(1) { top: 10px; }
  .burger span:nth-child(2) { top: calc(50% - 1px); }
  .burger span:nth-child(3) { bottom: 10px; }
  .burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(5px) rotate(45deg); }
  .burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-5px) rotate(-45deg); }

  /* .bar .icon-btn 보다 구체적이어야 데스크톱에서 햄버거가 숨는다 */
  .bar .mobile-only { display: none; }
  .mobile-panel { display: none; }

  @media (max-width: 809px) {
    /* 칸 셋은 그대로 — ☰ · 로고 · 🔍☾ 로 로고가 계속 가운데 선다. 높이는 --header-h 가 60px 로 바뀐다 */
    .brand { font-size: 28px; }
    .menu { display: none; }
    .tools { gap: 8px; }
    .lang-slot { display: none; }
    .bar .mobile-only { display: inline-flex; }

    .mobile-panel:not([hidden]) {
      display: block;
      position: fixed;
      inset: var(--header-h) 0 0;
      overflow-y: auto;
      background: var(--bg);
    }
    .panel-links {
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding-block: 16px 32px;
    }
    /* 세로 목록에선 글자 폭만큼만 차지해야 밑줄이 글자 아래에만 그어진다 */
    .panel-links a { align-self: flex-start; padding: 8px 0; }
    .panel-links a::after { left: 0; right: 0; bottom: 2px; }
    .panel-links .divider { margin: 8px 0; }
    .panel-links :global(.lang-text) {
      padding: 8px 0;
      font-size: 16px;
      font-weight: 600;
      color: var(--text);
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.getElementById('mobile-menu');
  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '');
      // 잠금은 body 가 아니라 html 에 건다 — global.css 의 html{overflow-x:clip} 탓에
      // body 의 overflow 가 더 이상 뷰포트로 전해지지 않아, 메뉴를 연 채로도 뒤가 그대로 스크롤됐다.
      document.documentElement.style.overflow = open ? 'hidden' : '';
    };
    toggle.addEventListener('click', () => setOpen(panel.hidden));
    panel.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });
    // 메뉴를 연 채로 창을 넓히면 패널이 숨겨져도 스크롤 잠금이 남는다
    matchMedia('(min-width: 810px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }

  // 히어로가 헤더 뒤로 올라오는 페이지에선, 스크롤하면 비워둔 헤더를 다시 칠한다(CSS 가 data-solid 를 본다).
  // 히어로에 큰 이름이 있으면 사진이 헤더 줄에 걸쳐 있어서, 조금만 내려도 칠하면 사진이 잘린다 —
  // 이름이 헤더 밑으로 들어간 뒤에야 칠하고, 그때 숨겨둔 헤더 로고도 꺼낸다(data-brand-shown).
  const header = document.querySelector<HTMLElement>('[data-header]');
  const heroName = document.querySelector<HTMLElement>('[data-hero-name]');
  if (header && (heroName || document.querySelector('[data-under-header]'))) {
    const onScroll = () => {
      const nameGone = !!heroName && heroName.getBoundingClientRect().bottom <= header.offsetHeight;
      header.toggleAttribute('data-solid', heroName ? nameGone : scrollY > 0);
      header.toggleAttribute('data-brand-shown', nameGone);
    };
    onScroll();
    addEventListener('scroll', onScroll, { passive: true });
  }
</script>
