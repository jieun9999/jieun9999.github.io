---
import BaseLayout from './BaseLayout.astro';
import { ui, formatDate, type Lang } from '../i18n/ui';
import type { MarkdownHeading } from 'astro';

type NavLink = { title: string; url: string } | null;
type Series = {
  title: string;
  parts: { title: string; url: string; order: number; current: boolean }[];
} | null;

interface Props {
  lang: Lang;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  headings: MarkdownHeading[];
  readingMinutes: number;
  cover?: string;
  coverAlt?: string;
  alternates: Record<Lang, string>;
  hreflang: Partial<Record<Lang, string>>;
  hasTranslation: boolean;
  prev?: NavLink;
  next?: NavLink;
  series?: Series;
}

const {
  lang,
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  headings,
  readingMinutes,
  cover,
  coverAlt,
  alternates,
  hreflang,
  hasTranslation,
  prev = null,
  next = null,
  series = null,
} = Astro.props;
const t = ui[lang];

// SNS 공유 이미지: 커버(/covers/x.webp) → OG용 JPG(/og/x.jpg)
const ogImage = cover
  ? cover.replace('/covers/', '/og/').replace(/\.webp$/, '.jpg')
  : undefined;

// 목차는 h2/h3 만 노출
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = toc.length > 1;
---

<BaseLayout
  title={`${title} · ${t.siteTitle}`}
  description={description}
  lang={lang}
  type="article"
  image={ogImage}
  alternates={alternates}
  hreflang={hreflang}
>
  <!-- 읽기 진행바 -->
  <div class="read-progress" aria-hidden="true"><div id="readbar"></div></div>

  <div class:list={['post', { 'has-toc': showToc }]}>
    {
      showToc && (
        <aside class="toc-col">
          <nav class="toc" aria-label={t.tableOfContents}>
            <p class="toc-title">{t.tableOfContents}</p>
            <ul>
              {toc.map((h) => (
                <li class:list={[`depth-${h.depth}`]}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }

    <div class="post-main">
      <a class="back-link" href={`/${lang}/`}>{t.backToList}</a>

      <header class="post-header">
        <h1>{title}</h1>
        <div class="meta">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
          <span class="dot">·</span>
          <span>{readingMinutes} {t.minRead}</span>
          {updatedDate && (
            <>
              <span class="dot">·</span>
              <span>{t.updatedOn} {formatDate(updatedDate, lang)}</span>
            </>
          )}
        </div>
        {
          tags.length > 0 && (
            <div class="tags">
              {tags.map((tag) => (
                <a class="tag" href={`/${lang}/tag/${encodeURIComponent(tag)}/`}>#{tag}</a>
              ))}
            </div>
          )
        }
        {!hasTranslation && (
          <p class="translation-note">{ui[lang === 'en' ? 'ko' : 'en'].noTranslation}</p>
        )}
      </header>

      {cover && (
        <img class="post-cover" src={cover} alt={coverAlt ?? title} loading="eager" />
      )}

      {
        series && (
          <aside class="series-box">
            <p class="series-label">
              {t.seriesLabel}
              {series.title ? ` · ${series.title}` : ''}
            </p>
            <ol class="series-parts">
              {series.parts.map((p) => (
                <li class:list={{ current: p.current }}>
                  {p.current ? (
                    <span>
                      {p.order}. {p.title}
                    </span>
                  ) : (
                    <a href={p.url}>
                      {p.order}. {p.title}
                    </a>
                  )}
                </li>
              ))}
            </ol>
          </aside>
        )
      }

      <article class="prose">
        <slot />
      </article>

      {
        (prev || next) && (
          <nav class="post-nav" aria-label="Post navigation">
            {prev ? (
              <a class="pn prev" href={prev.url}>
                <span class="pn-label">← {t.prevPost}</span>
                <span class="pn-title">{prev.title}</span>
              </a>
            ) : (
              <span />
            )}
            {next ? (
              <a class="pn next" href={next.url}>
                <span class="pn-label">{t.nextPost} →</span>
                <span class="pn-title">{next.title}</span>
              </a>
            ) : (
              <span />
            )}
          </nav>
        )
      }
    </div>
  </div>

  <!-- 맨 위로 -->
  <button id="toTop" class="to-top" type="button" aria-label={t.backToTop}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
  </button>
</BaseLayout>

<style>
  .post {
    display: block;
    max-width: var(--width-prose);
    margin-inline: auto;
  }
  @media (min-width: 64rem) {
    .post.has-toc {
      display: grid;
      grid-template-columns: minmax(0, var(--width-prose)) 15rem;
      gap: 3rem;
      max-width: none;
      justify-content: center;
    }
    .post.has-toc .post-main { grid-column: 1; grid-row: 1; }
    .post.has-toc .toc-col { grid-column: 2; grid-row: 1; }
  }

  .back-link {
    display: inline-block;
    margin-bottom: 1.75rem;
    font-size: 0.88rem;
    color: var(--text-muted);
  }
  .back-link:hover { color: var(--accent); }

  .post-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin: 0 0 0.85rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-muted);
    font-size: 0.88rem;
  }
  .meta .dot { color: var(--text-subtle); }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.9rem;
  }
  .tags .tag { text-decoration: none; }
  .translation-note {
    font-size: 0.85rem;
    color: var(--text-muted);
    background: var(--accent-soft);
    border-left: 3px solid var(--accent);
    padding: 0.6rem 0.85rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    margin-top: 1.1rem;
  }

  /* 커버 히어로 이미지 (해시노드처럼 본문 최상단) */
  .post-cover {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 1.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: zoom-in;
  }

  .prose { margin-top: 2.5rem; }

  /* 시리즈 박스 */
  .series-box {
    margin-top: 1.75rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .series-label {
    margin: 0 0 0.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .series-parts {
    margin: 0;
    padding-left: 0;
    list-style: none;
    counter-reset: none;
    display: grid;
    gap: 0.3rem;
    font-size: 0.92rem;
  }
  .series-parts li { color: var(--text-muted); }
  .series-parts a { color: var(--text-muted); text-decoration: none; }
  .series-parts a:hover { color: var(--accent); }
  .series-parts li.current { color: var(--text); font-weight: 650; }

  /* 이전/다음 글 */
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .pn {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: inherit;
    transition: border-color 0.15s, background 0.15s;
  }
  .pn:hover { border-color: var(--accent); background: var(--surface); }
  .pn.next { text-align: right; }
  .pn-label { font-size: 0.78rem; color: var(--text-subtle); }
  .pn-title { font-size: 0.95rem; font-weight: 650; color: var(--text); line-height: 1.35; }
  @media (max-width: 34rem) {
    .post-nav { grid-template-columns: 1fr; }
    .pn.next { text-align: left; }
  }

  /* 목차 */
  .toc-col { margin-bottom: 2rem; }
  .toc {
    font-size: 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 1rem 1.1rem;
    background: var(--surface);
  }
  @media (min-width: 64rem) {
    .toc-col { margin-bottom: 0; }
    .toc {
      position: sticky;
      top: 5.25rem;
      max-height: calc(100vh - 7rem);
      overflow-y: auto;
      border: none;
      background: transparent;
      padding: 0;
      border-left: 1px solid var(--border);
      padding-left: 1.1rem;
    }
  }
  .toc-title {
    font-weight: 650;
    color: var(--text-subtle);
    margin: 0 0 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.68rem;
  }
  .toc ul { list-style: none; margin: 0; padding: 0; }
  .toc li { margin: 0.35rem 0; line-height: 1.4; }
  .toc li.depth-3 { padding-left: 0.85rem; }
  .toc a {
    color: var(--text-muted);
    border-left: 2px solid transparent;
    margin-left: -1.1rem;
    padding-left: 1.1rem;
    display: block;
    transition: color 0.15s, border-color 0.15s;
  }
  .toc a:hover { color: var(--accent); }
  .toc a.active {
    color: var(--accent);
    font-weight: 600;
    border-left-color: var(--accent);
  }

  /* 읽기 진행바 */
  .read-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 60;
    background: transparent;
    pointer-events: none;
  }
  #readbar {
    height: 100%;
    width: 0;
    background: var(--accent);
    transition: width 0.1s linear;
  }

  /* 맨 위로 버튼 */
  .to-top {
    position: fixed;
    right: 1.5rem;
    bottom: 1.5rem;
    width: 2.6rem;
    height: 2.6rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--card);
    color: var(--text-muted);
    box-shadow: var(--shadow-md);
    cursor: pointer;
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
    transition: opacity 0.2s, transform 0.2s, color 0.15s, border-color 0.15s;
    z-index: 55;
  }
  .to-top.show { opacity: 1; transform: none; pointer-events: auto; }
  .to-top:hover { color: var(--accent); border-color: var(--accent); }
</style>

<script is:inline>
  (() => {
    const de = document.documentElement;

    // 읽기 진행바
    const bar = document.getElementById('readbar');
    const toTop = document.getElementById('toTop');
    const onScroll = () => {
      const max = de.scrollHeight - de.clientHeight;
      const pct = max > 0 ? (de.scrollTop / max) * 100 : 0;
      if (bar) bar.style.width = pct + '%';
      if (toTop) toTop.classList.toggle('show', de.scrollTop > 600);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // 맨 위로
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    toTop?.addEventListener('click', () =>
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' })
    );

    // 목차 활성 섹션 하이라이트
    const links = [...document.querySelectorAll('.toc a')];
    if (links.length) {
      const map = new Map();
      links.forEach((a) => map.set(decodeURIComponent(a.getAttribute('href').slice(1)), a));
      const heads = [...document.querySelectorAll('.prose h2, .prose h3')].filter((h) =>
        map.has(h.id)
      );
      const setActive = (id) => {
        links.forEach((l) => l.classList.remove('active'));
        map.get(id)?.classList.add('active');
      };
      const obs = new IntersectionObserver(
        (entries) => {
          const vis = entries.filter((e) => e.isIntersecting);
          if (vis.length) setActive(vis[0].target.id);
        },
        { rootMargin: '-10% 0px -70% 0px', threshold: 0 }
      );
      heads.forEach((h) => obs.observe(h));
    }
  })();
</script>
