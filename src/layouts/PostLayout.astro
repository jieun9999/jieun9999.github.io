---
import BaseLayout from './BaseLayout.astro';
import { ui, formatDate, type Lang } from '../i18n/ui';
import type { MarkdownHeading } from 'astro';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  headings: MarkdownHeading[];
  readingMinutes: number;
  alternates: Record<Lang, string>;
  hreflang: Partial<Record<Lang, string>>;
  hasTranslation: boolean;
}

const {
  lang,
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  headings,
  readingMinutes,
  alternates,
  hreflang,
  hasTranslation,
} = Astro.props;
const t = ui[lang];

// 목차는 h2/h3 만 노출
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = toc.length > 1;
---

<BaseLayout
  title={`${title} · ${t.siteTitle}`}
  description={description}
  lang={lang}
  type="article"
  alternates={alternates}
  hreflang={hreflang}
>
  <div class:list={['post', { 'has-toc': showToc }]}>
    {
      showToc && (
        <aside class="toc-col">
          <nav class="toc" aria-label={t.tableOfContents}>
            <p class="toc-title">{t.tableOfContents}</p>
            <ul>
              {toc.map((h) => (
                <li class:list={[`depth-${h.depth}`]}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )
    }

    <div class="post-main">
      <a class="back-link" href={`/${lang}/`}>{t.backToList}</a>

      <header class="post-header">
        <h1>{title}</h1>
        <div class="meta">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
          <span class="dot">·</span>
          <span>{readingMinutes} {t.minRead}</span>
          {updatedDate && (
            <>
              <span class="dot">·</span>
              <span>{t.updatedOn} {formatDate(updatedDate, lang)}</span>
            </>
          )}
        </div>
        {
          tags.length > 0 && (
            <div class="tags">
              {tags.map((tag) => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
          )
        }
        {!hasTranslation && (
          <p class="translation-note">{ui[lang === 'en' ? 'ko' : 'en'].noTranslation}</p>
        )}
      </header>

      <article class="prose">
        <slot />
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .post {
    display: block;
    max-width: var(--width-prose);
    margin-inline: auto;
  }
  /* 넓은 화면: 본문(중앙) + 우측 sticky 목차 */
  @media (min-width: 64rem) {
    .post.has-toc {
      display: grid;
      grid-template-columns: minmax(0, var(--width-prose)) 15rem;
      gap: 3rem;
      max-width: none;
      justify-content: center;
    }
    .post.has-toc .post-main { grid-column: 1; grid-row: 1; }
    .post.has-toc .toc-col { grid-column: 2; grid-row: 1; }
  }

  .back-link {
    display: inline-block;
    margin-bottom: 1.75rem;
    font-size: 0.88rem;
    color: var(--text-muted);
  }
  .back-link:hover { color: var(--accent); }

  .post-header h1 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin: 0 0 0.85rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-muted);
    font-size: 0.88rem;
  }
  .meta .dot { color: var(--text-subtle); }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.9rem;
  }
  .translation-note {
    font-size: 0.85rem;
    color: var(--text-muted);
    background: var(--accent-soft);
    border-left: 3px solid var(--accent);
    padding: 0.6rem 0.85rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    margin-top: 1.1rem;
  }

  .prose { margin-top: 2.5rem; }

  /* 목차 */
  .toc-col { margin-bottom: 2rem; }
  .toc {
    font-size: 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 1rem 1.1rem;
    background: var(--surface);
  }
  @media (min-width: 64rem) {
    .toc-col { margin-bottom: 0; }
    .toc {
      position: sticky;
      top: 5.25rem;
      border: none;
      background: transparent;
      padding: 0;
      border-left: 1px solid var(--border);
      padding-left: 1.1rem;
    }
  }
  .toc-title {
    font-weight: 650;
    color: var(--text-subtle);
    margin: 0 0 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.68rem;
  }
  .toc ul { list-style: none; margin: 0; padding: 0; }
  .toc li { margin: 0.35rem 0; line-height: 1.4; }
  .toc li.depth-3 { padding-left: 0.85rem; }
  .toc a { color: var(--text-muted); }
  .toc a:hover { color: var(--accent); }
</style>
