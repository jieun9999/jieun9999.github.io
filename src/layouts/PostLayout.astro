---
import BaseLayout from './BaseLayout.astro';
import PostMeta from '../components/PostMeta.astro';
import ProfileWidget from '../components/ProfileWidget.astro';
import { ui, categoryLabel, type Lang } from '../i18n/ui';
import { categoryUrl, tagUrl } from '../lib/posts';
import type { MarkdownHeading } from 'astro';

type NavLink = { title: string; url: string; cover?: string } | null;
type Series = {
  title: string;
  parts: { title: string; url: string; order: number; current: boolean }[];
} | null;

interface Props {
  lang: Lang;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  tags: string[];
  headings: MarkdownHeading[];
  readingMinutes: number;
  cover?: string;
  coverAlt?: string;
  coverCaption?: string;
  /** 글별 SNS 공유 카드(/og/<lang>/<slug>.jpg). 없으면 기본 배너로 폴백. */
  ogImage?: string;
  alternates: Record<Lang, string>;
  hreflang: Partial<Record<Lang, string>>;
  canonicalURL?: string;
  hasTranslation: boolean;
  /** 사이드바 프로필에 띄울 이 언어의 글 수 */
  postCount: number;
  prev?: NavLink;
  next?: NavLink;
  series?: Series;
}

const {
  lang,
  title,
  description,
  pubDate,
  updatedDate,
  category,
  tags,
  headings,
  readingMinutes,
  cover,
  coverAlt,
  coverCaption,
  ogImage,
  alternates,
  hreflang,
  canonicalURL,
  hasTranslation,
  postCount,
  prev = null,
  next = null,
  series = null,
} = Astro.props;
const t = ui[lang];

// 목차는 h2/h3 만 노출
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = toc.length > 1;

// "다음 글" = 이어서 읽을 더 오래된 글. 가장 오래된 글이면 더 최신 글을 대신 건다.
const upNext = prev
  ? { label: t.nextArticle, link: prev }
  : next
    ? { label: t.newerArticle, link: next }
    : null;
---

<BaseLayout
  title={`${title} · ${t.siteTitle}`}
  description={description}
  lang={lang}
  type="article"
  image={ogImage}
  alternates={alternates}
  hreflang={hreflang}
  canonicalURL={canonicalURL}
>
  <!-- 읽기 진행바 -->
  <div class="read-progress" aria-hidden="true"><div id="readbar"></div></div>

  <div class="post-wrap frame">
    <article class="post-main">
      <header class="post-header">
        <div class="meta-row">
          <PostMeta lang={lang} date={pubDate} mins={readingMinutes} updated={updatedDate} />
          <a class="chip" href={categoryUrl(lang, category)}>{categoryLabel(category)}</a>
        </div>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        {!hasTranslation && (
          <p class="translation-note">{ui[lang === 'en' ? 'ko' : 'en'].noTranslation}</p>
        )}
      </header>

      {cover && (
        <figure class="post-cover-fig">
          <img class="post-cover" src={cover} alt={coverAlt ?? title} loading="eager" />
          {coverCaption && <figcaption class="post-cover-caption">{coverCaption}</figcaption>}
        </figure>
      )}

      {
        series && (
          <aside class="series-box">
            <p class="eyebrow">
              {t.seriesLabel}
              {series.title ? ` · ${series.title}` : ''}
            </p>
            <ol class="series-parts">
              {series.parts.map((p) => (
                <li class:list={{ current: p.current }}>
                  {p.current ? <span aria-current="page">{p.title}</span> : <a href={p.url}>{p.title}</a>}
                </li>
              ))}
            </ol>
          </aside>
        )
      }

      {
        showToc && (
          <details class="toc-inline">
            <summary class="eyebrow">{t.tableOfContents}</summary>
            <ul>
              {toc.map((h) => (
                <li class:list={[`depth-${h.depth}`]}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </details>
        )
      }

      <div class="prose">
        <slot />
      </div>

      {
        tags.length > 0 && (
          <div class="post-tags">
            {tags.map((tag) => (
              <a class="tag" href={tagUrl(lang, tag)}>
                #{tag}
              </a>
            ))}
          </div>
        )
      }

      {
        upNext && (
          <nav class="up-next" aria-label={upNext.label}>
            <p class="eyebrow">{upNext.label}</p>
            <a class="next-card" href={upNext.link.url}>
              {upNext.link.cover && (
                <span class="next-img">
                  <img src={upNext.link.cover} alt="" loading="lazy" decoding="async" />
                </span>
              )}
              <span class="next-title">{upNext.link.title}</span>
            </a>
          </nav>
        )
      }
    </article>

    <div class="vline" aria-hidden="true"></div>

    <aside class="sidebar">
      {
        showToc && (
          <nav class="toc" aria-label={t.tableOfContents}>
            <p class="eyebrow">{t.tableOfContents}</p>
            <ul>
              {toc.map((h) => (
                <li class:list={[`depth-${h.depth}`]}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      <ProfileWidget lang={lang} count={postCount} />
    </aside>
  </div>

  <!-- 맨 위로 -->
  <button id="toTop" class="to-top" type="button" aria-label={t.backToTop}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg>
  </button>
</BaseLayout>

<style>
  .post-wrap {
    display: flex;
    align-items: flex-start;
    gap: 48px;
    padding-block: 64px;
  }
  .post-main {
    flex: 1 1 0;
    min-width: 0;
  }
  .vline {
    flex: none;
    align-self: stretch;
    width: 1px;
    background: linear-gradient(180deg, var(--bg-2) 0%, var(--surface-2) 49%, var(--bg-2) 100%);
  }
  .sidebar {
    flex: none;
    position: sticky;
    top: 30px;
    width: 240px;
    max-height: calc(100vh - 60px);
    overflow-y: auto;
    scrollbar-width: thin;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  /* 머리말 */
  .meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .post-header h1 {
    margin-top: 20px;
    font-size: 36px;
    font-weight: 800;
    line-height: 1.2;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .lede {
    margin-top: 16px;
    font-size: 22px;
    font-weight: 400;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .translation-note {
    margin-top: 16px;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-2);
    font-size: 14px;
    color: var(--text-muted);
  }

  /* 커버 */
  .post-cover-fig { margin: 40px 0 0; }
  .post-cover {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--hairline);
    cursor: zoom-in;
  }
  .post-cover-caption {
    margin-top: 10px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-subtle);
    text-align: center;
  }

  .prose { margin-top: 48px; }

  /* 시리즈 박스 */
  .series-box {
    margin-top: 32px;
    padding: 16px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-2);
  }
  .series-box .eyebrow { margin-bottom: 10px; color: var(--accent); }
  .series-parts {
    margin: 0;
    padding-left: 1.3em;
    display: grid;
    gap: 6px;
    font-size: 15px;
    line-height: 1.45;
  }
  .series-parts li { color: var(--text-subtle); }
  .series-parts li::marker { font-weight: 700; }
  .series-parts a { color: var(--text-muted); font-weight: 600; }
  .series-parts a:hover { color: var(--accent); }
  .series-parts li.current { color: var(--text); font-weight: 800; }

  /* 태그 */
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 48px;
  }

  /* 다음 글 카드 */
  .up-next {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 56px;
  }
  .next-card {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-2);
    color: var(--text);
    transition: background 0.2s, border-color 0.2s;
  }
  .next-card:hover { background: var(--surface); color: var(--text); }
  .next-img {
    position: relative;
    flex: none;
    width: 118px;
    aspect-ratio: 1.5;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .next-img img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .next-title {
    font-size: 18px;
    font-weight: 800;
    line-height: 1.45;
  }

  /* 목차 (사이드바) */
  .toc { display: flex; flex-direction: column; gap: 16px; }
  .toc ul,
  .toc-inline ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--border);
  }
  .toc li,
  .toc-inline li { margin: 0; }
  .toc a,
  .toc-inline a {
    display: block;
    margin-left: -1px;
    padding: 5px 0 5px 12px;
    border-left: 2px solid transparent;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text-subtle);
    transition: color 0.15s, border-color 0.15s;
  }
  .toc li.depth-3 a,
  .toc-inline li.depth-3 a { padding-left: 24px; font-weight: 500; }
  .toc a:hover,
  .toc-inline a:hover { color: var(--text); }
  .toc a.active {
    color: var(--accent);
    border-left-color: var(--accent);
  }

  /* 좁은 화면용 접이식 목차 — 넓은 화면에선 사이드바가 대신한다 */
  .toc-inline { display: none; }

  /* 읽기 진행바 */
  .read-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 60;
    pointer-events: none;
  }
  #readbar {
    height: 100%;
    width: 0;
    background: var(--accent-bg);
    transition: width 0.1s linear;
  }

  /* 맨 위로 버튼 */
  .to-top {
    position: fixed;
    right: 24px;
    bottom: 24px;
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    color: var(--text-muted);
    box-shadow: var(--shadow-md);
    cursor: pointer;
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
    transition: opacity 0.2s, transform 0.2s, color 0.15s;
    z-index: 55;
  }
  .to-top.show { opacity: 1; transform: none; pointer-events: auto; }
  .to-top:hover { color: var(--accent); }

  @media (max-width: 1199px) {
    .post-wrap {
      flex-direction: column;
      align-items: stretch;
      gap: 48px;
      padding-block: 36px;
    }
    .vline { display: none; }
    .sidebar {
      position: static;
      width: 100%;
      max-width: 360px;
      max-height: none;
      overflow: visible;
    }
    .sidebar .toc { display: none; }
    .toc-inline {
      display: block;
      margin-top: 32px;
      padding: 14px 18px;
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
    }
    .toc-inline summary { cursor: pointer; }
    .toc-inline[open] summary { margin-bottom: 12px; }
  }
  @media (max-width: 809px) {
    .post-wrap { padding-block: 24px; }
    .post-header h1 { font-size: 28px; }
    .lede { font-size: 18px; }
    .post-cover-fig { margin-top: 28px; }
    .prose { margin-top: 32px; font-size: 17px; }
    .next-img { width: 88px; }
    .next-title { font-size: 16px; }
  }
</style>

<script is:inline>
  (() => {
    const de = document.documentElement;

    // 읽기 진행바
    const bar = document.getElementById('readbar');
    const toTop = document.getElementById('toTop');
    const onScroll = () => {
      const max = de.scrollHeight - de.clientHeight;
      const pct = max > 0 ? (de.scrollTop / max) * 100 : 0;
      if (bar) bar.style.width = pct + '%';
      if (toTop) toTop.classList.toggle('show', de.scrollTop > 600);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // 맨 위로
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    toTop?.addEventListener('click', () =>
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' })
    );

    // 목차 활성 섹션 하이라이트 (사이드바 목차)
    const links = [...document.querySelectorAll('.toc a')];
    if (links.length) {
      const map = new Map();
      links.forEach((a) => map.set(decodeURIComponent(a.getAttribute('href').slice(1)), a));
      const heads = [...document.querySelectorAll('.prose h2, .prose h3')].filter((h) =>
        map.has(h.id)
      );
      const setActive = (id) => {
        links.forEach((l) => l.classList.remove('active'));
        map.get(id)?.classList.add('active');
      };
      const obs = new IntersectionObserver(
        (entries) => {
          const vis = entries.filter((e) => e.isIntersecting);
          if (vis.length) setActive(vis[0].target.id);
        },
        { rootMargin: '-10% 0px -70% 0px', threshold: 0 }
      );
      heads.forEach((h) => obs.observe(h));
    }
  })();
</script>
