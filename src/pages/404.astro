---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 · Not Found" description="Page not found" lang="en">
  <section style="text-align:center; padding:4rem 0;">
    <h1 style="font-size:3rem; margin:0;">404</h1>
    <p style="color:var(--text-muted);">This page could not be found. / 페이지를 찾을 수 없습니다.</p>
    <p style="display:flex; gap:1rem; justify-content:center; margin-top:1.5rem;">
      <a href="/en/">English home</a>
      <a href="/ko/">한국어 홈</a>
    </p>
  </section>
</BaseLayout>
