---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { ui } from '../i18n/ui';
---

<BaseLayout title="404 · Not Found" description="Page not found" lang="en">
  <Hero title="404" />
  <section class="frame body">
    <p>{ui.en.notFound}<br />{ui.ko.notFound}</p>
    <p class="links">
      <a class="chip" href="/en/">English home</a>
      <a class="chip" href="/ko/">한국어 홈</a>
    </p>
  </section>
</BaseLayout>

<style>
  .body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding-block: 48px 80px;
    text-align: center;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .links { display: flex; gap: 10px; }
</style>
