---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Hero from '../../../components/Hero.astro';
import PostList from '../../../components/PostList.astro';
import TagPill from '../../../components/TagPill.astro';
import BackToTop from '../../../components/BackToTop.astro';
import { ui, languages, type Lang } from '../../../i18n/ui';
import { getPosts, tagStats } from '../../../lib/posts';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of Object.keys(languages) as Lang[]) {
    for (const { tag } of tagStats(await getPosts(lang))) {
      paths.push({ params: { lang, tag } });
    }
  }
  return paths;
}

const { lang, tag } = Astro.params as { lang: Lang; tag: string };
const t = ui[lang];
const posts = (await getPosts(lang)).filter((p) => p.data.tags.includes(tag));
---

<BaseLayout title={`#${tag} · ${t.siteTitle}`} description={`${t.siteTitle} — #${tag}`} lang={lang}>
  <Hero title={`#${tag}`} plain snug />

  <div class="frame list-page">
    <PostList lang={lang} posts={posts} pageSize={8}>
      <p slot="label" class="list-label"><TagPill tag={tag} count={posts.length} /></p>
    </PostList>
  </div>
  <BackToTop lang={lang} />
</BaseLayout>

<style>
  .list-page { padding-block: 64px; }
  /* 태그 목록에서 누른 알약을 그대로 라벨로 — 어떤 태그를 보고 있는지, 글이 몇 개인지 */
  .list-label { margin: 0; }
  @media (max-width: 1199px) {
    .list-page { padding-block: 48px; }
  }
  @media (max-width: 809px) {
    .list-page { padding-block: 24px 36px; }
  }
</style>
