---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProfileCard from '../../components/ProfileCard.astro';
import PostCard from '../../components/PostCard.astro';
import {
  ui,
  languages,
  langFromId,
  keyFromId,
  readingMinutes,
  type Lang,
} from '../../i18n/ui';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = ui[lang];

const posts = (await getCollection('blog'))
  .filter((p) => langFromId(p.id) === lang && !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={t.siteTitle} description={t.tagline} lang={lang}>
  <div class="feed">
    <ProfileCard lang={lang} count={posts.length} />

    <ul class="feed-list">
      {
        posts.map((post) => (
          <PostCard
            lang={lang}
            slug={keyFromId(post.id)}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            mins={readingMinutes(post.body ?? '')}
            cover={post.data.cover}
            coverAlt={post.data.coverAlt}
          />
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .feed {
    /* 해시노드형 단일 컬럼 — 큰 모니터에서 큼직하게 (px 기반) */
    width: min(100%, 980px);
    margin-inline: auto;
    /* 글자 크기 (큰 모니터에서 충분히 크게, 본문 .prose 스케일은 불변) */
    font-size: clamp(17px, 15px + 0.28vw, 20px);
  }
  .feed-list {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    display: grid;
    gap: 1.75rem;
  }
</style>
