---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProfileCard from '../../components/ProfileCard.astro';
import PostCard from '../../components/PostCard.astro';
import {
  ui,
  languages,
  langFromId,
  keyFromId,
  readingMinutes,
  type Lang,
} from '../../i18n/ui';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = ui[lang];

const posts = (await getCollection('blog'))
  .filter((p) => langFromId(p.id) === lang && !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={t.siteTitle} description={t.tagline} lang={lang}>
  <div class="feed">
    <ProfileCard lang={lang} count={posts.length} />

    <ul class="feed-list">
      {
        posts.map((post) => (
          <PostCard
            lang={lang}
            slug={keyFromId(post.id)}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            mins={readingMinutes(post.body ?? '')}
            cover={post.data.cover}
            coverAlt={post.data.coverAlt}
          />
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .feed {
    /* 아담한 단일 컬럼 — px 기반이라 큰 모니터(2560)에서도 해시노드처럼 좁게 유지.
       (바깥 main.frame 이 이미 좌우 gutter 패딩을 주므로 여기선 100%만 제한) */
    width: min(100%, 720px);
    margin-inline: auto;
    /* 전역 폰트 스케일(최대 20px) 폭주 방지 — 본문 .prose 스케일은 불변 */
    font-size: clamp(16px, 0.95rem + 0.1vw, 18px);
  }
  .feed-list {
    list-style: none;
    padding: 0;
    margin: 2.25rem 0 0;
    display: grid;
    gap: 1.25rem;
  }
</style>
