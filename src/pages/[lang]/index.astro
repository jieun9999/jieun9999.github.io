---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProfileHero from '../../components/ProfileHero.astro';
import ArticleBrowser from '../../components/ArticleBrowser.astro';
import BackToTop from '../../components/BackToTop.astro';
import { ui, languages, type Lang } from '../../i18n/ui';
import { getPosts } from '../../lib/posts';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = ui[lang];

const posts = await getPosts(lang);
---

<BaseLayout title={t.siteTitle} description={t.tagline} lang={lang}>
  <ProfileHero lang={lang} nameHeading />
  <ArticleBrowser lang={lang} allPosts={posts} />
  <BackToTop lang={lang} />
</BaseLayout>
