---
// GitHub Pages 정적 이동 페이지. 원문은 docs/writing/archive에 보존합니다.
export function getStaticPaths() {
  return ['ko', 'en'].map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang;
const target = `/${lang}/blog/part1-three-tier-dev-environment/`;
const canonical = new URL(target, Astro.site).href;
const title = lang === 'ko' ? '통합한 글로 이동합니다' : 'This article has been consolidated';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <h1>{title}</h1>
    <p><a href={target}>{lang === 'ko' ? '통합 글 읽기' : 'Read the consolidated article'}</a></p>
    <script is:inline define:vars={{ target }}>
      location.replace(target);
    </script>
  </body>
</html>
