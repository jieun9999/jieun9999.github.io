---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection, render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';
import { langFromId, keyFromId, otherLang, readingMinutes, languages, type Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  const exists = new Set(posts.map((p) => p.id));

  // 언어별 최신순 목록 (prev/next·series 계산용)
  const byLang: Record<string, typeof posts> = {};
  for (const lang of Object.keys(languages)) {
    byLang[lang] = posts
      .filter((p) => langFromId(p.id) === lang)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  }

  return posts.map((post) => {
    const lang = langFromId(post.id);
    const key = keyFromId(post.id);
    const other = otherLang(lang);
    const hasTranslation = exists.has(`${other}/${key}`);

    const alternates = {
      [lang]: `/${lang}/blog/${key}/`,
      [other]: hasTranslation ? `/${other}/blog/${key}/` : `/${other}/`,
    } as Record<Lang, string>;

    const hreflang: Partial<Record<Lang, string>> = { [lang]: `/${lang}/blog/${key}/` };
    if (hasTranslation) hreflang[other] = `/${other}/blog/${key}/`;

    // 이전(더 오래된) / 다음(더 최신) 글
    const list = byLang[lang];
    const i = list.findIndex((p) => p.id === post.id);
    const nav = (p: (typeof posts)[number] | undefined) =>
      p ? { title: p.data.title, url: `/${lang}/blog/${keyFromId(p.id)}/` } : null;
    const prev = nav(list[i + 1]); // 이전 글 = 더 오래된 글
    const next = nav(list[i - 1]); // 다음 글 = 더 최신 글

    // 시리즈
    let series = null;
    if (post.data.series) {
      const parts = list
        .filter((p) => p.data.series === post.data.series)
        .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
        .map((p) => ({
          title: p.data.title,
          url: `/${lang}/blog/${keyFromId(p.id)}/`,
          order: p.data.seriesOrder ?? 0,
          current: p.id === post.id,
        }));
      series = { title: post.data.seriesTitle ?? '', parts };
    }

    // canonical: 기본은 self. frontmatter 에 canonicalURL 이 있을 때만 그쪽으로 넘긴다.
    //   (예전엔 crosspost 영문 글의 canonical 을 해쉬노드로 넘겼다. jieun.dev 단독 운영으로
    //    돌아서면서 제거 — 한/영 모두 이 레포가 검색 대표다.)
    const canonicalURL = post.data.canonicalURL;

    // 글별 SNS 공유 카드. `node scripts/gen-og.mjs` 로 미리 만들어 커밋해 둔다.
    // 없으면 og:image 가 404 가 되므로(=미리보기가 빈 카드) 기본 배너로 폴백한다.
    // 빌드는 Node 에서 프로젝트 루트를 cwd 로 돌기 때문에 여기서 파일 존재를 볼 수 있다.
    const ogPath = `/og/${lang}/${key}.jpg`;
    const ogImage = fs.existsSync(path.join('public', ogPath)) ? ogPath : undefined;

    return {
      params: { lang, slug: key },
      props: { post, alternates, hreflang, canonicalURL, hasTranslation, prev, next, series, ogImage },
    };
  });
}

const { post, alternates, hreflang, canonicalURL, hasTranslation, prev, next, series, ogImage } = Astro.props;
const lang = langFromId(post.id);
const { Content, headings } = await render(post);
const mins = readingMinutes(post.body ?? '');
---

<PostLayout
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  headings={headings}
  readingMinutes={mins}
  cover={post.data.cover}
  coverAlt={post.data.coverAlt}
  coverCaption={post.data.coverCaption}
  ogImage={ogImage}
  alternates={alternates}
  hreflang={hreflang}
  canonicalURL={canonicalURL}
  hasTranslation={hasTranslation}
  prev={prev}
  next={next}
  series={series}
>
  <Content />
</PostLayout>
