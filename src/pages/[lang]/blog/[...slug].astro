---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';
import { langFromId, keyFromId, otherLang, readingMinutes, languages, type Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  // 해쉬노드 발행물 주소 (crosspost 글의 canonical 대상 · 교차발행 스크립트와 동일해야 함)
  const HASHNODE_BASE = 'https://beckybuilds.hashnode.dev';
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  const exists = new Set(posts.map((p) => p.id));

  // 언어별 최신순 목록 (prev/next·series 계산용)
  const byLang: Record<string, typeof posts> = {};
  for (const lang of Object.keys(languages)) {
    byLang[lang] = posts
      .filter((p) => langFromId(p.id) === lang)
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  }

  return posts.map((post) => {
    const lang = langFromId(post.id);
    const key = keyFromId(post.id);
    const other = otherLang(lang);
    const hasTranslation = exists.has(`${other}/${key}`);

    const alternates = {
      [lang]: `/${lang}/blog/${key}/`,
      [other]: hasTranslation ? `/${other}/blog/${key}/` : `/${other}/`,
    } as Record<Lang, string>;

    const hreflang: Partial<Record<Lang, string>> = { [lang]: `/${lang}/blog/${key}/` };
    if (hasTranslation) hreflang[other] = `/${other}/blog/${key}/`;

    // 이전(더 오래된) / 다음(더 최신) 글
    const list = byLang[lang];
    const i = list.findIndex((p) => p.id === post.id);
    const nav = (p: (typeof posts)[number] | undefined) =>
      p ? { title: p.data.title, url: `/${lang}/blog/${keyFromId(p.id)}/` } : null;
    const prev = nav(list[i + 1]); // 이전 글 = 더 오래된 글
    const next = nav(list[i - 1]); // 다음 글 = 더 최신 글

    // 시리즈
    let series = null;
    if (post.data.series) {
      const parts = list
        .filter((p) => p.data.series === post.data.series)
        .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
        .map((p) => ({
          title: p.data.title,
          url: `/${lang}/blog/${keyFromId(p.id)}/`,
          order: p.data.seriesOrder ?? 0,
          current: p.id === post.id,
        }));
      series = { title: post.data.seriesTitle ?? '', parts };
    }

    // canonical: 수동 override 우선 → crosspost 영문 글이면 해쉬노드 원본 → 없으면 self
    const canonicalURL =
      post.data.canonicalURL ??
      (post.data.crosspost && lang === 'en' ? `${HASHNODE_BASE}/${key}` : undefined);

    return {
      params: { lang, slug: key },
      props: { post, alternates, hreflang, canonicalURL, hasTranslation, prev, next, series },
    };
  });
}

const { post, alternates, hreflang, canonicalURL, hasTranslation, prev, next, series } = Astro.props;
const lang = langFromId(post.id);
const { Content, headings } = await render(post);
const mins = readingMinutes(post.body ?? '');
---

<PostLayout
  lang={lang}
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  tags={post.data.tags}
  headings={headings}
  readingMinutes={mins}
  cover={post.data.cover}
  coverAlt={post.data.coverAlt}
  coverCaption={post.data.coverCaption}
  alternates={alternates}
  hreflang={hreflang}
  canonicalURL={canonicalURL}
  hasTranslation={hasTranslation}
  prev={prev}
  next={next}
  series={series}
>
  <Content />
</PostLayout>
