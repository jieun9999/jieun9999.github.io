---
// 소개 페이지 — 카드 한 장. 왼쪽 프로필 그림(홈 히어로와 같은 것), 오른쪽 인사 · 짧은 소개 · 링크 아이콘.
// 소개 문장은 전 회사 지칭 규칙(CLAUDE.md)을 따른다 — 과거형, 회사명·연차·직함 없이.
// 카드 뒤에는 홈 히어로와 같은 에버그린 점을 깔고, 홈처럼 헤더 뒤까지 올린다 — 메뉴를 오가도 바탕이 이어지게.
// 들어올 때 움직임은 홈 히어로와 같은 말투(GSAP) — 카드가 떠오르고 그림이 튀어오르며, 인사 단어 · 소개 · 아이콘이 차례로 떠오른다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import Particles from '../../components/Particles.astro';
import { ui, languages, avatarLargeSrc, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = ui[lang];

function highlightParts(value: string) {
  return value.split(/(==[^=]+==)/g);
}

const copy = {
  ko: {
    greeting: '안녕하세요, 정지은입니다',
    photoAlt: '정지은',
    summary: '사람들이 실제로 계속 사용할 수 있는 서비스를 만들고 싶습니다.',
    bio: [
      '저는 사람들이 실제로 계속 사용할 수 있는 서비스를 만들고 싶습니다.',
      '자동화 블로그 SaaS인 위블로그를 만들면서, 글이 어떤 구조를 가져야 구글에 잘 색인되는지, 사람들이 실제로 검색하는 글 제목은 무엇인지, 매일 글을 발행하는 운영자가 무엇을 가장 오래 고민하는지 살폈습니다.',
      '==기능을 많이 붙이는 일보다 먼저 해야 할 일은, 블로그를 운영하는 사람이 어디에서 막히는지 알아내고 그 문제를 해결하는 것이라고 생각합니다.==',
      '자동화하더라도 사람의 판단까지 없애고 싶지는 않습니다. 사람이 고른 자료와 내린 결정은 남겨두고, 반복되는 수집·생성·발행은 시스템에 맡기는 쪽을 좋아합니다. 검증에 필요한 지표가 충분히 쌓이지 않았다면 성과를 쉽게 말하지 않습니다.',
      '==서비스가 실제로 운영되는 과정에서 생기는 비용·지연시간·실패 가능성까지 설계의 일부로 봅니다.==',
      '결국 제가 만들고 싶은 건 기술적으로만 그럴듯한 서비스가 아닙니다. ==사용자가 편하게 쓰고, 운영자가 감당할 수 있고, 문제가 생겨도 다시 회복할 수 있는 서비스입니다.== 이 블로그에는 그런 서비스를 만들어 가며 무엇을 선택했고, 무엇을 포기했고, 그 선택을 왜 다시 바꾸었는지를 기록합니다.',
    ],
  },
  en: {
    greeting: "Hi, I'm Jieun Jeong",
    photoAlt: 'Jieun Jeong',
    summary: 'A backend engineer who owns a service end to end, from design to deployment and operations.',
    bio: [
      "I'm a backend engineer who owns a service end to end, from design to deployment and operations.",
      "Building a blog automation SaaS from scratch, I designed the pipeline that runs from keyword discovery to publishing on a custom domain, along with zero-downtime deploys. I'm strongest at choosing by measuring cost and speed, and at moving slow work off the request path. I write up what I fixed along the way on this blog.",
    ],
  },
} satisfies Record<Lang, { greeting: string; photoAlt: string; summary: string; bio: string[] }>;
const c = copy[lang];
const words = c.greeting.split(/\s+/).filter(Boolean);
---

<BaseLayout title={`${t.about} · ${t.siteTitle}`} description={c.summary} lang={lang}>
  <div class="field" data-under-header>
    <Particles max={200} />
    <div class="frame about">
      <section class="card" aria-labelledby="about-title">
        <img class="photo" src={avatarLargeSrc} alt={c.photoAlt} width="1024" height="1024" loading="eager" />
        <div class="intro">
          <h1 id="about-title">
            {words.map((w, i) => <>{i > 0 && ' '}<span>{w}</span></>)}
          </h1>
          {c.bio.map((paragraph) => (
            <p class="bio">
              {highlightParts(paragraph).map((part) =>
                part.startsWith('==') ? <mark>{part.slice(2, -2)}</mark> : part
              )}
            </p>
          ))}
          <div class="links">
            <SocialLinks toast="start" muted />
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* 점 바탕 — Hero snug 와 같은 방식으로 헤더 높이만큼 위로 올라간다(헤더를 비우는 건 Header.astro) */
  .field {
    position: relative;
    overflow: hidden;
    margin-top: calc(-1 * var(--header-h));
    padding-top: var(--header-h);
    background: linear-gradient(180deg, var(--bg) 0%, var(--bg-2) 100%);
  }
  .about {
    position: relative;
    z-index: 1;
    padding-block: 40px 88px;
  }
  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 34px;
    padding: 44px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
  }
  .photo {
    display: block;
    width: min(100%, 280px);
    max-width: 280px;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--hairline);
    background: var(--surface);
  }
  .intro { display: flex; flex-direction: column; width: min(100%, 1000px); }
  .intro h1 {
    font-size: clamp(28px, 3.4vw, 38px);
    font-weight: 900;
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--text);
    text-wrap: balance;
  }
  .bio {
    margin-top: 20px;
    max-width: 52em;
    font-size: 18px;
    line-height: 1.85;
    color: var(--text-subtle);
    word-break: keep-all;
  }
  .bio + .bio { margin-top: 18px; }
  .bio mark {
    color: var(--text);
    background: var(--accent-soft);
    border-radius: 0.25em;
    padding: 0.08em 0.18em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  /* 아이콘 원 안쪽 여백만큼 당겨 글줄 왼쪽 끝에 맞춘다 */
  .links { margin: 28px 0 0 -6px; }

  /* 들어올 때 모션은 GSAP(아래 스크립트) — 인사 단어가 따로 떠오르게 블록처럼 세우고,
     뜨기 전엔 점과 카드를 숨겨 둔다(src/lib/motion.ts) */
  .intro h1 span { display: inline-block; }
  :global(html.gsap-enter) .field > :global(*) { opacity: 0; }

  @media (max-width: 1199px) {
    .card { gap: 30px; padding: 32px; }
  }
  @media (max-width: 809px) {
    .about { padding-block: 16px 56px; }
    .card { gap: 28px; padding: 20px 20px 24px; }
    .photo { width: min(100%, 240px); max-width: 240px; }
    .bio { margin-top: 16px; font-size: 16px; line-height: 1.85; }
    .links { margin-top: 22px; }
  }
</style>

<script>
  import { enterTimeline, POP, DOTS } from '../../lib/motion';

  // 들어올 때 — 홈 히어로와 같은 말투. 점이 번지고 카드가 떠오르며, 그림이 튀어오르고
  // 인사 단어 → 소개 → 링크 아이콘이 차례로 떠오른다.
  const tl = enterTimeline();
  if (tl) {
    tl.from('.field > [data-particles]', DOTS, 0)
      .from('.card', { opacity: 0, y: 24 }, 0)
      .from('.photo', { ...POP, scale: 0.92, ease: 'back.out(1.4)' }, 0.1)
      .from('.intro h1 span', { opacity: 0, y: 24, stagger: 0.07 }, 0.25)
      .from('.bio, .links', { opacity: 0, y: 16, stagger: 0.1 }, '-=0.55');
  }
</script>
