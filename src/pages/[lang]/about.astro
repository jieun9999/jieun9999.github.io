---
// 소개 페이지 — 카드 한 장. 왼쪽 프로필 그림(홈 히어로와 같은 것), 오른쪽 인사 · 짧은 소개 · 링크 아이콘.
// 소개 문장은 전 회사 지칭 규칙(CLAUDE.md)을 따른다 — 과거형, 회사명·연차·직함 없이.
// 카드 뒤에는 홈 히어로와 같은 에버그린 점을 깔고, 홈처럼 헤더 뒤까지 올린다 — 메뉴를 오가도 바탕이 이어지게.
// 들어올 때 움직임은 홈 히어로와 같은 말투(GSAP) — 카드가 떠오르고 그림이 튀어오르며, 인사 단어 · 소개 · 아이콘이 차례로 떠오른다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import Particles from '../../components/Particles.astro';
import { ui, languages, avatarLargeSrc, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = ui[lang];

// ==형광펜==, **굵게** 두 가지 강조를 쪼갠다
function highlightParts(value: string) {
  return value.split(/(==[^=]+==|\*\*[^*]+\*\*)/g);
}

const copy = {
  ko: {
    greeting: '안녕하세요 개발자 정지은입니다.',
    photoAlt: '정지은',
    summary: '백엔드를 중심으로 제품의 설계부터 배포·운영까지 주도하는 Product Engineer입니다.',
    bio: [
      '**백엔드를 중심으로 제품의 설계부터 배포·운영까지 주도하는 Product Engineer입니다.**',
      '교육사업을 직접 운영하며 고객의 문제를 이해하고 해결해 온 경험이 있습니다. 이후 소프트웨어 엔지니어로서 SaaS 제품의 초기 설계, 백엔드 개발, 인프라 구축 및 운영을 담당했습니다.',
      '기술 자체보다 해결해야 할 문제를 먼저 정의하고, 비즈니스 요구사항과 기술적 트레이드오프를 함께 고려하는 개발을 지향합니다.',
    ],
  },
  en: {
    greeting: "Hello, I'm Jieun Jeong, a developer.",
    photoAlt: 'Jieun Jeong',
    summary: "I'm a Product Engineer who leads products from design through deployment and operations, with a focus on the backend.",
    bio: [
      "**I'm a Product Engineer who leads products from design through deployment and operations, with a focus on the backend.**",
      "I ran an education business myself, where I learned to understand and solve customers' problems firsthand. Later, as a software engineer, I was responsible for the early design, backend development, and infrastructure setup and operations of a SaaS product.",
      "Rather than starting from the technology itself, I first define the problem that needs solving, and I aim to build with both business requirements and technical trade-offs in mind.",
    ],
  },
} satisfies Record<Lang, { greeting: string; photoAlt: string; summary: string; bio: string[] }>;
const c = copy[lang];
const words = c.greeting.split(/\s+/).filter(Boolean);
---

<BaseLayout title={`${t.about} · ${t.siteTitle}`} description={c.summary} lang={lang}>
  <div class="field" data-under-header>
    <Particles max={200} />
    <div class="frame about">
      <section class="card" aria-labelledby="about-title">
        <img class="photo" src={avatarLargeSrc} alt={c.photoAlt} width="1024" height="1024" loading="eager" />
        <div class="intro">
          <h1 id="about-title">
            {words.map((w, i) => <>{i > 0 && ' '}<span>{w}</span></>)}
          </h1>
          {c.bio.map((paragraph) => (
            <p class="bio">
              {highlightParts(paragraph).map((part) =>
                part.startsWith('==') ? <mark>{part.slice(2, -2)}</mark>
                : part.startsWith('**') ? <strong>{part.slice(2, -2)}</strong>
                : part
              )}
            </p>
          ))}
          <div class="links">
            <SocialLinks toast="start" muted />
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* 점 바탕 — Hero snug 와 같은 방식으로 헤더 높이만큼 위로 올라간다(헤더를 비우는 건 Header.astro) */
  .field {
    position: relative;
    overflow: hidden;
    margin-top: calc(-1 * var(--header-h));
    padding-top: var(--header-h);
    background: linear-gradient(180deg, var(--bg) 0%, var(--bg-2) 100%);
  }
  .about {
    position: relative;
    z-index: 1;
    padding-block: 40px 88px;
  }
  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 34px;
    padding: 44px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
  }
  .photo {
    display: block;
    width: min(100%, 280px);
    max-width: 280px;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--hairline);
    background: var(--surface);
  }
  .intro { display: flex; flex-direction: column; width: min(100%, 1000px); }
  .intro h1 {
    font-size: clamp(28px, 3.4vw, 38px);
    font-weight: 900;
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--text);
    text-wrap: balance;
  }
  .bio {
    margin-top: 20px;
    max-width: 52em;
    font-size: 18px;
    line-height: 1.85;
    color: var(--text-subtle);
    word-break: keep-all;
  }
  .bio + .bio { margin-top: 18px; }
  .bio mark {
    color: var(--text);
    background: var(--accent-soft);
    border-radius: 0.25em;
    padding: 0.08em 0.18em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  .bio strong { color: var(--text); font-weight: 800; }
  /* 아이콘 원 안쪽 여백만큼 당겨 글줄 왼쪽 끝에 맞춘다 */
  .links { margin: 28px 0 0 -6px; }

  /* 들어올 때 모션은 GSAP(아래 스크립트) — 인사 단어가 따로 떠오르게 블록처럼 세우고,
     뜨기 전엔 점과 카드를 숨겨 둔다(src/lib/motion.ts) */
  .intro h1 span { display: inline-block; }
  :global(html.gsap-enter) .field > :global(*) { opacity: 0; }

  @media (max-width: 1071px) {
    .card { gap: 30px; padding: 32px; }
  }
  @media (max-width: 809px) {
    .about { padding-block: 16px 56px; }
    .card { gap: 28px; padding: 20px 20px 24px; }
    .photo { width: min(100%, 240px); max-width: 240px; }
    .bio { margin-top: 16px; font-size: 16px; line-height: 1.85; }
    .links { margin-top: 22px; }
  }
</style>

<script>
  import { enterTimeline, POP, DOTS } from '../../lib/motion';

  // 들어올 때 — 홈 히어로와 같은 말투. 점이 번지고 카드가 떠오르며, 그림이 튀어오르고
  // 인사 단어 → 소개 → 링크 아이콘이 차례로 떠오른다.
  const tl = enterTimeline();
  if (tl) {
    tl.from('.field > [data-particles]', DOTS, 0)
      .from('.card', { opacity: 0, y: 24 }, 0)
      .from('.photo', { ...POP, scale: 0.92, ease: 'back.out(1.4)' }, 0.1)
      .from('.intro h1 span', { opacity: 0, y: 24, stagger: 0.07 }, 0.25)
      .from('.bio, .links', { opacity: 0, y: 16, stagger: 0.1 }, '-=0.55');
  }
</script>
