---
// 소개 페이지 — 카드 한 장. 왼쪽 프로필 그림(홈 히어로와 같은 것), 오른쪽 인사 · 짧은 소개 · 링크 아이콘.
// 소개 문장은 전 회사 지칭 규칙(CLAUDE.md)을 따른다 — 과거형, 회사명·연차·직함 없이.
// 들어올 때 움직임은 홈 히어로와 같은 말투 — 그림이 튀어오르고(pop), 인사 단어·소개·아이콘이 차례로 떠오른다(rise).
import BaseLayout from '../../layouts/BaseLayout.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { ui, languages, avatarLargeSrc, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = ui[lang];

const copy = {
  ko: {
    greeting: '안녕하세요, 정지은입니다',
    photoAlt: '정지은',
    summary: '설계부터 배포·운영까지 서비스를 끝까지 책임지는 백엔드 개발자입니다.',
    bio: '설계부터 배포·운영까지 서비스를 끝까지 책임지는 백엔드 개발자입니다. 블로그 자동화 SaaS를 처음부터 만들며 키워드 발굴에서 도메인 발행까지 이어지는 파이프라인과 무중단 배포를 설계했습니다. 특히 비용과 속도를 숫자로 재서 고르는 일, 느린 작업을 요청 밖으로 떼어내는 구조에 강합니다. 그 과정에서 고친 것들을 이 블로그에 기록합니다.',
  },
  en: {
    greeting: "Hi, I'm Jieun Jeong",
    photoAlt: 'Jieun Jeong',
    summary: 'A backend engineer who owns a service end to end, from design to deployment and operations.',
    bio: "I'm a backend engineer who owns a service end to end, from design to deployment and operations. Building a blog automation SaaS from scratch, I designed the pipeline that runs from keyword discovery to publishing on a custom domain, along with zero-downtime deploys. I'm strongest at choosing by measuring cost and speed, and at moving slow work off the request path. I write up what I fixed along the way on this blog.",
  },
} satisfies Record<Lang, { greeting: string; photoAlt: string; summary: string; bio: string }>;
const c = copy[lang];
const words = c.greeting.split(/\s+/).filter(Boolean);
---

<BaseLayout title={`${t.about} · ${t.siteTitle}`} description={c.summary} lang={lang}>
  <div class="frame about">
    <section class="card" aria-labelledby="about-title">
      <img class="photo" src={avatarLargeSrc} alt={c.photoAlt} width="1024" height="1024" loading="eager" />
      <div class="intro">
        <h1 id="about-title">
          {words.map((w, i) => <>{i > 0 && ' '}<span style={`--i:${i}`}>{w}</span></>)}
        </h1>
        <p class="bio" style={`--i:${words.length}`}>{c.bio}</p>
        <div class="links" style={`--i:${words.length + 1}`}>
          <SocialLinks toast="start" muted />
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about { padding-block: 40px 88px; }
  .card {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    align-items: center;
    gap: 56px;
    padding: 44px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg);
  }
  .photo {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--hairline);
    background: var(--surface);
  }
  .intro { display: flex; flex-direction: column; }
  .intro h1 {
    font-size: clamp(28px, 3.4vw, 38px);
    font-weight: 900;
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--text);
    text-wrap: balance;
  }
  .bio {
    margin-top: 22px;
    max-width: 34em;
    font-size: 17px;
    line-height: 1.9;
    color: var(--text-subtle);
    word-break: keep-all;
  }
  /* 아이콘 원 안쪽 여백만큼 당겨 글줄 왼쪽 끝에 맞춘다 */
  .links { margin: 28px 0 0 -6px; }

  /* 들어올 때 — 값은 Hero.astro 와 같다 (foundations.md "움직임") */
  .photo { animation: pop 0.6s cubic-bezier(0.34, 1.4, 0.64, 1) 0.1s both; }
  .intro h1 span { display: inline-block; }
  .intro h1 span,
  .bio,
  .links {
    animation: rise 0.5s ease both;
    animation-delay: calc(0.25s + var(--i) * 0.08s);
  }
  @keyframes pop {
    from { opacity: 0; transform: scale(0.9); }
    to { opacity: 1; transform: none; }
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 1199px) {
    .card { gap: 40px; padding: 32px; }
  }
  @media (max-width: 809px) {
    .about { padding-block: 16px 56px; }
    .card { grid-template-columns: minmax(0, 1fr); gap: 28px; padding: 20px 20px 24px; }
    .photo { max-width: 360px; }
    .bio { margin-top: 16px; font-size: 16px; line-height: 1.85; }
    .links { margin-top: 22px; }
  }
</style>
